[{"time":20101230107,"id":[128,22,126],"loc":[64,152,23],"lines":[{"line":"Hmm?","wav":"Sound\\Voice\\Skyrim.esm\\MaleYoungEager\\DialogueGe_DialogueGeneric_000142C0_1.wav"},{"line":"Is there anything I can help you with?","wav":""},{"line":"Nah. I don't think so.","wav":"Sound\\Voice\\Skyrim.esm\\MaleYoungEager\\DialogueGe_DialogueGeneric_000E0CC4_1.wav"}]},{"time":20101230111,"id":[128,22,183],"loc":[64,152,23],"lines":[{"line":"Don't bother me, peasant. I've had a long journey and paid too much coin on these gifts to be late to Vittoria's wedding.","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\WEDL03_WEDL03PlautisDialog_000B9106_1.wav"},{"line":"Enjoy the wedding.","wav":""},{"line":"Indeed. If we ever get there.","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\WEDL03_WEDL03Goodbye01_000B9104_1.wav"}]}]