[{"time":20107311512,"id":[65,52,132],"loc":[65,49,99],"line":{"line":"All right, then.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleChild\\DialogueGe_DialogueGeneric_000854CD_1.wav"},"topic":[65,64,254]},{"time":20107311515,"id":[65,183,71],"loc":[65,49,99],"line":{"line":"Cause trouble in Whiterun, and I'll haul you into the Dragonsreach dungeon myself.","wav":"Sound\\Voice\\Guard Dialogue Overhaul.esp\\MaleNordCommander\\DialogueGuardsGeneral__00014B68_1.wav"},"topic":[66,189,221]},{"time":20107311516,"id":[65,183,71],"loc":[65,49,99],"line":{"line":"Let me guess - someone stole your sweetroll...","wav":"Sound\\Voice\\Skyrim.esm\\MaleNordCommander\\DialogueGuardsGeneral__0002BE10_1.wav"},"topic":[66,189,221]},{"time":20107311531,"id":[65,52,139],"loc":[65,49,99],"line":{"line":"Hey, no fair! Get her, Stump!","wav":"Sound\\Voice\\Skyrim.esm\\MaleChild\\DialogueRi__000340BA_1.wav"},"topic":[67,64,176]},{"time":20107311536,"id":[0,135,227],"loc":[65,49,99],"line":{"line":"Until next time.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleDarkElf\\DialogueGe_DialogueGeneric_00087935_1.wav"},"topic":[65,64,254]},{"time":20107311537,"id":[67,85,12],"loc":[65,49,99],"line":{"line":"What do you want?","wav":"Sound\\Voice\\Skyrim.esm\\MaleDrunk\\DialogueGe_DialogueGeneric_000A9B37_1.wav"},"topic":[65,66,181]},{"time":20107311538,"id":[67,85,12],"loc":[65,49,99],"line":{"line":"Need something?","wav":"Sound\\Voice\\Skyrim.esm\\MaleDrunk\\DialogueGe_DialogueGeneric_00087947_1.wav"},"topic":[65,66,181]},{"time":20107311539,"id":[65,52,136],"loc":[65,203,141],"line":{"line":"Well, one of us has to do something!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleYoungEager\\MS13LucanCamillaScene__0003834A_1.wav"},"topic":[67,130,183]},{"time":20107311540,"id":[65,52,136],"loc":[65,203,141],"line":{"line":"Be careful!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleYoungEager\\DialogueGe_DialogueGeneric_0006CB2C_1.wav"},"topic":[65,66,174]},{"time":20107311541,"id":[65,52,135],"loc":[65,203,141],"line":{"line":"I said no! No adventures, no theatrics, no thief-chasing!","wav":"Sound\\Voice\\Skyrim.esm\\MaleSlyCynical\\MS13LucanCamillaScene__0001725E_1.wav"},"topic":[65,114,49]},{"time":20107311542,"id":[65,52,136],"loc":[65,203,141],"line":{"line":"Well, what are you going to do then, huh? Let's hear it!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleYoungEager\\MS13LucanCamillaScene__000382C5_1.wav"},"topic":[67,130,92]},{"time":20107311543,"id":[65,52,135],"loc":[65,203,141],"line":{"line":"We are done talking about this.","wav":"Sound\\Voice\\Skyrim.esm\\MaleSlyCynical\\MS13LucanCamillaScene__000382B8_1.wav"},"topic":[67,130,93]},{"time":20107311545,"id":[65,52,135],"loc":[65,203,141],"line":{"line":"Oh, a customer. Sorry you had to hear that.","wav":"Sound\\Voice\\Skyrim.esm\\MaleSlyCynical\\MS13LucanCamillaScene__000BCD17_1.wav"},"topic":[75,205,10]},{"time":20107311552,"id":[65,52,135],"loc":[65,203,141],"line":{"line":"You could? I've got some coin coming in from my last shipment. It's yours if you bring my claw back.","wav":"Sound\\Voice\\Skyrim.esm\\MaleSlyCynical\\MS13_MS13LucanVolunteerTop_0008AFA2_1.wav"},"topic":[69,212,111]},{"time":20107311553,"id":[65,52,136],"loc":[65,203,141],"line":{"line":"Maybe you could talk some sense into my pig-headed brother.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleYoungEager\\MS13__000176A6_1.wav"},"topic":[67,150,34]},{"time":20107311554,"id":[65,52,135],"loc":[65,203,141],"line":{"line":"Now, if you're going to get those thieves, you should head to Bleak Falls Barrow, northwest of town.","wav":"Sound\\Voice\\Skyrim.esm\\MaleSlyCynical\\MS13__0001AACA_1.wav"},"topic":[65,168,37]},{"time":20107311555,"id":[65,52,136],"loc":[65,203,141],"line":{"line":"So this is your plan, Lucan?","wav":"Sound\\Voice\\Skyrim.esm\\FemaleYoungEager\\MS13__000382BE_1.wav"},"topic":[67,129,74]},{"time":20107311555,"id":[65,52,136],"loc":[65,203,141],"line":{"line":"Be careful!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleYoungEager\\DialogueGe_DialogueGeneric_0006CB2C_1.wav"},"topic":[65,66,174]},{"time":20107311556,"id":[65,52,135],"loc":[65,203,141],"line":{"line":"Yes. So now you don't have to go, do you?","wav":"Sound\\Voice\\Skyrim.esm\\MaleSlyCynical\\MS13__00038309_1.wav"},"topic":[67,129,73]},{"time":20107311557,"id":[65,52,136],"loc":[65,203,141],"line":{"line":"Oh really? Well I think your new helper here needs a guide.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleYoungEager\\MS13__000382C3_1.wav"},"topic":[67,129,72]},{"time":20107311559,"id":[65,52,135],"loc":[65,203,141],"line":{"line":"Wh- no... I... Oh, by the Eight, fine. But only to the edge of town!","wav":"Sound\\Voice\\Skyrim.esm\\MaleSlyCynical\\MS13__000382B9_1.wav"},"topic":[67,129,71]},{"time":20107311601,"id":[65,52,136],"loc":[65,203,141],"line":{"line":"This way.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleYoungEager\\MS13__000176A7_1.wav"},"topic":[67,150,34]},{"time":20107311613,"id":[65,52,145],"loc":[65,203,141],"line":{"line":"Then what are you wasting my time for?","wav":"Sound\\Voice\\TheChoiceIsYours.esp\\MaleYoungEager\\FreeformRi_FreeformRiverwo_00013063_2.wav"},"topic":[1,141,187]},{"time":20107311616,"id":[65,52,136],"loc":[65,49,99],"line":{"line":"We have to go through town and across the bridge to get to Bleak Falls Barrow.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleYoungEager\\MS13__0002E2C8_2.wav"},"topic":[66,226,199]},{"time":20107311617,"id":[65,52,145],"loc":[65,49,99],"line":{"line":"That letter ought to convince Camilla to never speak to Faendal ever again.","wav":"Sound\\Voice\\TheChoiceIsYours.esp\\MaleYoungEager\\FreeformRi_FreeformRiverwo_00013062_1.wav"},"topic":[1,141,188]},{"time":20107311619,"id":[65,52,136],"loc":[65,49,99],"line":{"line":"Those thieves must be mad, hiding out there. Those old crypts are filled with nothing but traps, trolls, and who knows what else!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleYoungEager\\MS13__00038308_2.wav"},"topic":[67,129,66]},{"time":20107311630,"id":[65,52,133],"loc":[65,203,140],"line":{"line":"Orgnar.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleUniqueDelphine\\DialogueRiverwood_Revised__000BCCC4_1.wav"},"topic":[75,199,105]},{"time":20107311631,"id":[65,52,134],"loc":[65,203,140],"line":{"line":"Hard not to.","wav":"Sound\\Voice\\Skyrim.esm\\MaleBrute\\DialogueRiverwood_Revised__000BCCBF_1.wav"},"topic":[75,197,218]},{"time":20107311632,"id":[65,52,133],"loc":[65,203,140],"line":{"line":"The ale is going bad. We need to get a new batch.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleUniqueDelphine\\DialogueRiverwood_Revised__000BCCB1_1.wav"},"topic":[75,197,211]},{"time":20107311633,"id":[65,52,133],"loc":[65,203,140],"line":{"line":"Did you hear me?","wav":"Sound\\Voice\\Skyrim.esm\\FemaleUniqueDelphine\\DialogueRiverwood_Revised__000BCCB0_1.wav"},"topic":[75,197,210]},{"time":20107311634,"id":[65,52,134],"loc":[65,203,140],"line":{"line":"Yep. Ale's going bad.","wav":"Sound\\Voice\\Skyrim.esm\\MaleBrute\\DialogueRiverwood_Revised__000BCC9C_1.wav"},"topic":[75,197,206]},{"time":20107311635,"id":[65,52,133],"loc":[65,203,140],"line":{"line":"I guess you don't have potatoes in your ears after all. Just make sure we get a fresh batch in soon.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleUniqueDelphine\\DialogueRiverwood_Revised__000BCAF3_1.wav"},"topic":[75,197,192]},{"time":20107311637,"id":[65,52,134],"loc":[65,203,140],"line":{"line":"Welcome. Let me know if you want anything... think I got a clean mug around here somewhere.","wav":"Sound\\Voice\\Skyrim.esm\\MaleBrute\\WITavern__000C7B0D_1.wav"},"topic":[77,238,131]},{"time":20107311724,"id":[65,52,140],"loc":[65,49,99],"line":{"line":"Until next time.","wav":"Sound\\Voice\\Skyrim.esm\\MaleEvenToned\\DialogueGe_DialogueGeneric_00087935_1.wav"},"topic":[65,64,254]},{"time":20107311728,"id":[65,52,134],"loc":[65,203,140],"line":{"line":"Welcome. Let me know if you want anything... think I got a clean mug around here somewhere.","wav":"Sound\\Voice\\Skyrim.esm\\MaleBrute\\WITavern__000C7B0D_1.wav"},"topic":[77,238,131]},{"time":20107312153,"id":[65,52,135],"loc":[65,203,140],"line":{"line":"Show those thieves not to steal from Lucan Valerius!","wav":"Sound\\Voice\\Skyrim.esm\\MaleSlyCynical\\MS13__0003963B_1.wav"},"topic":[67,150,34]},{"time":20107312155,"id":[65,52,135],"loc":[65,203,140],"line":{"line":"The sooner you find the claw, the sooner our lives can get back to normal.","wav":"Sound\\Voice\\Skyrim.esm\\MaleSlyCynical\\MS13__0003963C_1.wav"},"topic":[67,150,34]},{"time":20107312213,"id":[65,52,130],"loc":[65,203,140],"line":{"line":"Until next time.","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\DialogueGe_DialogueGeneric_00087935_1.wav"},"topic":[65,64,254]},{"time":20107312214,"id":[65,52,145],"loc":[65,203,140],"line":{"line":"This is an ode to Skyrim's staunch protectors... the Imperials.","wav":"Sound\\Voice\\Skyrim.esm\\MaleYoungEager\\BardSongs__000E89D7_1.wav"},"topic":[78,137,203]},{"time":20107312218,"id":[65,52,145],"loc":[65,203,140],"line":{"line":"We drink to our youth, to days come and gone. For the age of aggression is just about done.","wav":"Sound\\Voice\\Skyrim.esm\\MaleYoungEager\\BardSongs__0009583F_1.wav"},"topic":[80,117,3]},{"time":20107312221,"id":[65,52,145],"loc":[65,203,140],"line":{"line":"We'll drive out the Stormcloaks and restore what we own. With our blood and our steel we'll take back our home.","wav":"Sound\\Voice\\Skyrim.esm\\MaleYoungEager\\BardSongs__00095840_1.wav"},"topic":[80,117,1]},{"time":20107312225,"id":[65,52,145],"loc":[65,203,140],"line":{"line":"Down with Ulfric the killer of kings. On the day of your death we'll drink and we'll sing.","wav":"Sound\\Voice\\Skyrim.esm\\MaleYoungEager\\BardSongs__00095841_1.wav"},"topic":[80,125,158]},{"time":20107312229,"id":[65,52,145],"loc":[65,203,140],"line":{"line":"We're the children of Skyrim, and we fight all our lives. And when Sovngarde beckons, every one of us dies!","wav":"Sound\\Voice\\Skyrim.esm\\MaleYoungEager\\BardSongs__000D0839_1.wav"},"topic":[77,8,12]},{"time":20107312232,"id":[65,52,145],"loc":[65,203,140],"line":{"line":"But this land is ours and we'll see it wiped clean. Of the scourge that has sullied our hopes and our dreams.","wav":"Sound\\Voice\\Skyrim.esm\\MaleYoungEager\\BardSongs__000D083A_1.wav"},"topic":[77,8,11]},{"time":20107312233,"id":[0,43,82],"loc":[65,203,140],"line":{"line":"An epic, to be precise.  One that's coming to its climax.  There's a tower on the horizon, canvassed by a sky the color of blood.","wav":"Sound\\Voice\\3DNPC.esp\\HjoromirVoice\\DialogueHj_DialogueHjoromi_00053B27_1.wav"},"topic":[1,157,219]},{"time":20107312238,"id":[0,43,82],"loc":[65,203,140],"line":{"line":"As I ride my steed closer, I see that coiled around the tower like a serpent is the evil dragon Numinex resurrected by Alduin.  ","wav":"Sound\\Voice\\3DNPC.esp\\HjoromirVoice\\DialogueHjoromir__00219BDC_2.wav"},"topic":[1,157,220]},{"time":20107312244,"id":[0,43,82],"loc":[65,203,140],"line":{"line":"He roars at the sight of me, and I answer him by raising the Sword of Dawn, shining like a beacon through the darkness.","wav":"Sound\\Voice\\3DNPC.esp\\HjoromirVoice\\DialogueHjoromir__00219BF1_3.wav"},"topic":[1,157,221]},{"time":20107312251,"id":[0,43,82],"loc":[65,203,140],"line":{"line":"I ride fast and low, evading the sweep of his talons.  I enter the tower where my princess awaits, but my task is not yet complete.  ","wav":"Sound\\Voice\\3DNPC.esp\\HjoromirVoice\\DialogueHjoromir__00219C07_5.wav"},"topic":[1,157,222]},{"time":20107312255,"id":[0,43,82],"loc":[65,203,140],"line":{"line":"A direct attack is foolish.  Numinex knows this. That's why I do it.  My aim is to shock him just long enough to run up his nose and behind his eyes.","wav":"Sound\\Voice\\3DNPC.esp\\HjoromirVoice\\DialogueHjoromir__00219BF6_7.wav"},"topic":[1,157,223]},{"time":20107312259,"id":[0,43,82],"loc":[65,203,140],"line":{"line":"Where the tender spot in his neck awaits my blade. ","wav":"Sound\\Voice\\3DNPC.esp\\HjoromirVoice\\DialogueHjoromir__00219C02_7.wav"},"topic":[1,157,224]},{"time":20107312321,"id":[65,52,133],"loc":[65,203,140],"line":{"line":"You're that visitor, been pokin' around.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleUniqueDelphine\\DialogueRiverwood_Revised__0004544B_1.wav"},"topic":[68,83,233]},{"time":20107312340,"id":[67,85,12],"loc":[65,203,140],"line":{"line":"What are you doing that for?","wav":"Sound\\Voice\\Skyrim.esm\\MaleDrunk\\DialogueGe_DialogueGeneric_0006AE39_1.wav"},"topic":[65,66,172]},{"time":20107312352,"id":[65,52,134],"loc":[65,203,140],"line":{"line":"Come on in. Just stoked the fire. Take a seat and get the cold out.","wav":"Sound\\Voice\\Skyrim.esm\\MaleBrute\\WITavern__000C7916_1.wav"},"topic":[77,238,131]},{"time":20108010705,"id":[65,52,139],"loc":[65,49,99],"line":{"line":"You're new around here, so I'll go easy on ya. But don't get on my bad side.","wav":"Sound\\Voice\\Skyrim.esm\\MaleChild\\DialogueRiverwood_Revised__0004542A_1.wav"},"topic":[68,83,233]},{"time":20108010912,"id":[65,52,131],"loc":[65,49,99],"line":{"line":"Ain't used to strangers here in Riverwood.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleEvenToned\\DialogueRiverwood_Revised__000453F3_1.wav"},"topic":[68,83,233]},{"time":20108010919,"id":[65,52,130],"loc":[65,49,99],"line":{"line":"All right, then.","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\DialogueGe_DialogueGeneric_000854CD_1.wav"},"topic":[65,64,254]},{"time":20108010920,"id":[65,52,130],"loc":[65,49,99],"line":{"line":"That's a decent weapon you've made there.","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\WICraftItem01__0009C135_1.wav"},"topic":[68,244,253]},{"time":20108010930,"id":[65,52,130],"loc":[65,49,99],"line":{"line":"Iron or steel is what you need. Leave that fancy Elven stuff to the Elves.","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\DialogueRiverwood_Revised__0004546B_1.wav"},"topic":[68,83,233]},{"time":20108010944,"id":[65,52,130],"loc":[65,49,99],"line":{"line":"Hmm hmm.","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\DialogueGe_DialogueGeneric_000854CE_1.wav"},"topic":[65,64,254]},{"time":20108010945,"id":[67,85,52],"loc":[65,49,99],"line":{"line":"Nobody believes me, but I tell you, I saw a dragon!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleOldGrumpy\\DialogueRiverwood_Revised__0004547C_1.wav"},"topic":[68,83,233]},{"time":20108010946,"id":[67,85,52],"loc":[65,49,99],"line":{"line":"By Shor, what do you want?","wav":"Sound\\Voice\\Skyrim.esm\\FemaleOldGrumpy\\DialogueRiverwood_Revised__000348F4_1.wav"},"topic":[68,83,233]},{"time":20108010951,"id":[0,135,240],"loc":[65,49,99],"line":{"line":"Safe travels.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleDarkElf\\DialogueGe_DialogueGeneric_000AA112_1.wav"},"topic":[65,64,254]},{"time":20108011004,"id":[0,135,240],"loc":[65,49,99],"line":{"line":"And what might you need? Hmm?","wav":"Sound\\Voice\\Skyrim.esm\\FemaleDarkElf\\DialogueGe_DialogueGeneric_000A9B3A_1.wav"},"topic":[65,66,181]},{"time":20108011013,"id":[0,135,240],"loc":[65,49,99],"line":{"line":"Gods! Another fight.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleDarkElf\\DialogueGeneric__0003CD24_1.wav"},"topic":[67,64,54]},{"time":20108011158,"id":[128,37,238],"loc":[64,150,117],"line":{"line":"Do you think Tiber Septim ever fought here? You know... Here! Wow...","wav":"Sound\\Voice\\Civil War Lines Expansion.esp\\MaleYoungEager\\CivilWarLi_CivilWarLinesEx_00000978_1.wav"},"topic":[1,163,100]},{"time":20108011158,"id":[128,37,252],"loc":[64,150,117],"line":{"line":"These are dark days... at least we know we're making our part to make things better, eh?","wav":"Sound\\Voice\\Civil War Lines Expansion.esp\\MaleYoungEager\\CivilWarLi_CivilWarLinesEx_00000976_1.wav"},"topic":[1,163,100]},{"time":20108011201,"id":[128,38,4],"loc":[64,150,117],"line":{"line":"Citizen, I'm warning you. Your presence is interfering with Imperial business. Be gone!","wav":"Sound\\Voice\\Skyrim.esm\\MaleSoldier\\CWSharedIn_CWSharedInfoSta_000C4A7D_1.wav"},"topic":[76,230,244]},{"time":20108011204,"id":[128,37,246],"loc":[64,150,117],"line":{"line":"If you know any true sons and daughters of Skyrim, tell them to head to Windhelm. Ulfric Stormcloak wants to see them.","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\CW00B_CW00BHello_000D3C59_1.wav"},"topic":[78,108,166]},{"time":20108011216,"id":[0,139,236],"loc":[77,171,136],"line":{"line":"(meow)","wav":"Sound\\Voice\\ACatsLife.esp\\ACLVoiceCat\\ACLQuestDi_ACLDialogueCats_0007F6AE_1.wav"},"topic":[1,172,185]},{"time":20108011234,"id":[66,201,41],"loc":[65,142,63],"line":{"line":"Mercy!","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\DialogueGeneric__00017708_1.wav"},"topic":[65,63,48]},{"time":20108011236,"id":[66,201,40],"loc":[65,138,86],"line":{"line":"Don't take this the wrong way, but you look a little sickly.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleYoungEager\\WICommentD_WICommentDiseas_000AD0E2_1.wav"},"topic":[74,208,206]},{"time":20108011247,"id":[75,160,203],"loc":[65,138,86],"line":{"line":"M'aiq wishes you well. ","wav":"Sound\\Voice\\Skyrim.esm\\MaleKhajiit\\WEMaiqTheL_WEMaiqTheLiarHe_000B9D00_1.wav"},"topic":[75,155,197]},{"time":20108011253,"id":[1,160,94],"loc":[65,138,86],"line":{"line":"Need something?","wav":"Sound\\Voice\\Skyrim.esm\\MaleBandit\\DialogueGe_DialogueGeneric_00087947_1.wav"},"topic":[65,66,181]},{"time":20108011258,"id":[73,25,24],"loc":[65,138,86],"line":{"line":"By Ysmir, it's true. A jester - funny suit and all. Just north, by the Loreius Farm. Fool had a coffin in a cart, with a broken wheel.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCommander\\DialogueWhiterun__00092B1A_1.wav"},"topic":[73,43,17]},{"time":20108011258,"id":[73,25,24],"loc":[65,138,86],"line":{"line":"Like to see him laugh his way out of that.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCommander\\DialogueWhiterun__000BC8B5_1.wav"},"topic":[75,200,177]},{"time":20108011314,"id":[73,25,24],"loc":[65,138,86],"line":{"line":"Ha ha ha ha ha ha ha!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCommander\\DialogueWhiterun__000BC8B4_1.wav"},"topic":[75,200,176]},{"time":20108011314,"id":[65,166,156],"loc":[65,138,86],"line":{"line":"Ha ha ha ha ha ha ha!","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\DialogueWhiterun__00092B1F_1.wav"},"topic":[73,43,18]},{"time":20108011315,"id":[73,25,24],"loc":[65,138,86],"line":{"line":"Good. Chat time's over.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCommander\\DialogueWhiterun__000918D4_1.wav"},"topic":[73,4,172]},{"time":20108011318,"id":[65,166,156],"loc":[65,138,86],"line":{"line":"Ride strong.","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\DialogueWhiterun__00090506_1.wav"},"topic":[73,4,172]},{"time":20108011320,"id":[65,166,158],"loc":[65,138,86],"line":{"line":"Need a horse? Talk to my father, Skulvar.","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommonerAccented\\DialogueWhiterun__0002ABA6_1.wav"},"topic":[66,112,122]},{"time":20108011321,"id":[65,166,156],"loc":[65,138,86],"line":{"line":"Well, sounds like you've had quite the journey, Uthgerd. But you were gone longer than usual. I got to thinking maybe you weren't coming back...","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\DialogueWhiterun__00092B1D_1.wav"},"topic":[73,43,24]},{"time":20108011323,"id":[0,134,59],"loc":[65,138,86],"line":{"line":"Yeah?","wav":"Sound\\Voice\\Skyrim.esm\\MaleOrc\\DialogueGe_DialogueGeneric_000A9B2C_1.wav"},"topic":[65,66,181]},{"time":20108011329,"id":[1,155,233],"loc":[65,138,86],"line":{"line":"All right, then.","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommonerAccented\\DialogueGe_DialogueGeneric_000854CD_1.wav"},"topic":[65,64,254]},{"time":20108011330,"id":[1,155,227],"loc":[65,138,86],"line":{"line":"Be careful!","wav":"Sound\\Voice\\Skyrim.esm\\MaleEvenToned\\DialogueGe_DialogueGeneric_0006CB2C_1.wav"},"topic":[65,66,174]},{"time":20108011331,"id":[0,136,207],"loc":[65,138,86],"line":{"line":"Yes?","wav":"Sound\\Voice\\Skyrim.esm\\MaleGuard\\DialogueGe_DialogueGeneric_00087940_1.wav"},"topic":[65,66,181]},{"time":20108011332,"id":[1,133,234],"loc":[65,138,86],"line":{"line":"What do you need?","wav":"Sound\\Voice\\Skyrim.esm\\MaleEvenToned\\DialogueGe_DialogueGeneric_000A9B2B_1.wav"},"topic":[65,66,181]},{"time":20108011333,"id":[0,136,201],"loc":[65,138,86],"line":{"line":"No lollygaggin'.","wav":"Sound\\Voice\\Skyrim.esm\\MaleNordCommander\\DialogueGuardsGeneral__0002BE0B_1.wav"},"topic":[66,189,221]},{"time":20108011343,"id":[65,166,137],"loc":[65,138,86],"line":{"line":"We'll pay whatever it takes, but we must have more swords for the Imperial soldiers.","wav":"Sound\\Voice\\Skyrim.esm\\MaleBrute\\DialogueWhiterun__000CC7AE_1.wav"},"topic":[76,199,171]},{"time":20108011345,"id":[65,166,124],"loc":[65,138,86],"line":{"line":"I just can't fill an order that size on my own. ","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCommander\\DialogueWhiterun__000CC7AF_1.wav"},"topic":[76,199,170]},{"time":20108011347,"id":[65,166,137],"loc":[65,138,86],"line":{"line":"Ha! I'd sooner bend my knee to Ulfric Stormcloak.","wav":"Sound\\Voice\\Skyrim.esm\\MaleBrute\\DialogueWhiterun__000CC7AD_1.wav"},"topic":[76,199,169]},{"time":20108011349,"id":[65,166,124],"loc":[65,138,86],"line":{"line":"Have it your way. I'll take the job, but don't expect a miracle.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCommander\\DialogueWhiterun__000CC7AC_1.wav"},"topic":[76,199,168]},{"time":20108011400,"id":[65,166,124],"loc":[65,138,86],"line":{"line":"Don't forget to check inside the shop if you need anything.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCommander\\DialogueWhiterun__00090502_1.wav"},"topic":[73,4,172]},{"time":20108011403,"id":[67,112,129],"loc":[65,138,86],"line":{"line":"They say Helgen got hit by a dragon. One of those horrors comes here, we'll be ready.","wav":"Sound\\Voice\\Skyrim.esm\\MaleGuard\\DialogueGuardsGeneral__000EA261_1.wav"},"topic":[66,189,221]},{"time":20108011426,"id":[80,0,247],"loc":[65,138,86],"line":{"line":"Trouble?","wav":"Sound\\Voice\\Skyrim.esm\\MaleNordCommander\\DialogueGuardsGeneral__000AD7E8_1.wav"},"topic":[66,189,221]},{"time":20108011427,"id":[65,166,117],"loc":[65,138,86],"line":{"line":"Remember, fresh fruit and vegetables every day. Mostly.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleEvenToned\\DialogueWhiterun__000904E0_1.wav"},"topic":[73,4,172]},{"time":20108011433,"id":[65,166,113],"loc":[65,248,109],"line":{"line":"Thank you, thank you. No, please, hold your applause.","wav":"Sound\\Voice\\Skyrim.esm\\MaleYoungEager\\DialogueWhiterun__00092A28_1.wav"},"topic":[73,42,36]},{"time":20108011434,"id":[65,166,110],"loc":[65,248,109],"line":{"line":"Come on in. Just stoked the fire. Take a seat and get the cold out.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleNord\\WITavern__000C7916_1.wav"},"topic":[77,238,131]},{"time":20108011434,"id":[65,166,113],"loc":[65,248,109],"line":{"line":"One more song, what say you? Yeah? All right, then!","wav":"Sound\\Voice\\Skyrim.esm\\MaleYoungEager\\DialogueWhiterun__00092A2E_1.wav"},"topic":[73,42,35]},{"time":20108011435,"id":[65,166,113],"loc":[65,248,109],"line":{"line":"Nnnnooowwwwwww...","wav":"Sound\\Voice\\Skyrim.esm\\MaleYoungEager\\DialogueWhiterun__00092A25_1.wav"},"topic":[73,42,34]},{"time":20108011435,"id":[0,167,223],"loc":[65,248,109],"line":{"line":"Good afternoon.","wav":"Sound\\Voice\\Skyrim.esm\\MaleEvenToned\\DialogueGe_DialogueGeneric_0002846F_1.wav"},"topic":[65,66,181]},{"time":20108011436,"id":[65,166,113],"loc":[65,248,109],"line":{"line":"There once was a hero named Ragnar the Red, who came riding to Whiterun from ole Rorikstead!","wav":"Sound\\Voice\\Skyrim.esm\\MaleYoungEager\\DialogueWhiterun__00092A26_1.wav"},"topic":[73,42,33]},{"time":20108011439,"id":[65,166,113],"loc":[65,248,109],"line":{"line":"It's the leaving that's hardest, I know.","wav":"Sound\\Voice\\Skyrim.esm\\MaleYoungEager\\DialogueWhiterun__000904C1_1.wav"},"topic":[73,4,172]}]