[{"time":20101230106,"id":[128,22,183],"loc":[64,152,23],"line":{"line":"Come along, no more stops, we need to find our way to Solitude.","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\WEDL03__000B813D_1.wav"},"topic":[75,129,58]},{"time":20101230108,"id":[128,22,178],"loc":[64,152,23],"line":{"line":"Why are we even going to a wedding at this far flung end of the Empire anyway?","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCoward\\WEDL03__000B813C_1.wav"},"topic":[75,129,57]},{"time":20101230109,"id":[128,22,126],"loc":[64,152,23],"line":{"line":"Hmm hmm.","wav":"Sound\\Voice\\Skyrim.esm\\MaleYoungEager\\DialogueGe_DialogueGeneric_000854CE_1.wav"},"topic":[65,64,254]},{"time":20101230110,"id":[128,22,178],"loc":[64,152,23],"line":{"line":"Ugh. Speak to my husband, if you must.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCoward\\WEDL03_WEDL03SaloniaDialog_000B9166_1.wav"},"topic":[75,144,189]},{"time":20101230111,"id":[128,22,183],"loc":[64,152,23],"line":{"line":"I told you, it's the wedding of Vittoria Vici, an extremely well connected merchant with the East Empire Company. The Emperor's cousin? Remember?","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\WEDL03__000B813B_1.wav"},"topic":[75,129,56]},{"time":20101230113,"id":[128,22,183],"loc":[64,152,23],"line":{"line":"Indeed. If we ever get there.","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\WEDL03_WEDL03Goodbye01_000B9104_1.wav"},"topic":[75,144,200]},{"time":20101230116,"id":[128,22,183],"loc":[64,151,247],"line":{"line":"Hopefully these gifts will put us in her good graces, secure that import deal, and lead the way to an audience with the Emperor. ","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\WEDL03__000B813E_1.wav"},"topic":[75,129,55]},{"time":20101230143,"id":[128,22,183],"loc":[64,151,216],"line":{"line":"Don't bother me, peasant. I've had a long journey and paid too much coin on these gifts to be late to Vittoria's wedding.","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\WEDL03_WEDL03PlautisDialog_000B9106_1.wav"},"topic":[75,144,201]},{"time":20101230150,"id":[128,36,70],"loc":[64,151,184],"line":{"line":"I'm on my way to Solitude to join the Legion. A united Empire is better for everyone.","wav":"Sound\\Voice\\Skyrim.esm\\MaleDarkElf\\WEDL13__000BD749_1.wav"},"topic":[75,215,62]},{"time":20101230158,"id":[77,18,65],"loc":[64,151,185],"line":{"line":"Never should have come here...","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommonerAccented\\DialogueGeneric__000854C2_1.wav"},"topic":[65,193,198]},{"time":20101230200,"id":[77,18,68],"loc":[64,151,185],"line":{"line":"Hhyyaarargghhhh!","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\DialogueGeneric__00013EBC_1.wav"},"topic":[65,62,186]},{"time":20101230200,"id":[77,18,65],"loc":[64,151,185],"line":{"line":"Nyyarrggh!","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommonerAccented\\DialogueGeneric__00013EF1_1.wav"},"topic":[65,62,227]},{"time":20101230200,"id":[77,18,68],"loc":[64,151,185],"line":{"line":"Agh!","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\DialogueGeneric__0006F41E_1.wav"},"topic":[65,62,187]},{"time":20101230200,"id":[77,18,65],"loc":[64,151,185],"line":{"line":"Nargh!","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommonerAccented\\DialogueGeneric__00042ED3_1.wav"},"topic":[65,62,187]},{"time":20101230201,"id":[77,18,68],"loc":[64,151,185],"line":{"line":"Yeagh!","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\DialogueGeneric__00013EF7_1.wav"},"topic":[65,62,187]},{"time":20101230201,"id":[77,18,68],"loc":[64,151,185],"line":{"line":"Yeagh!","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\DialogueGeneric__00013EF7_1.wav"},"topic":[65,62,187]},{"time":20101230202,"id":[77,18,65],"loc":[64,151,185],"line":{"line":"Gods, no!","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommonerAccented\\DialogueGeneric__00017711_1.wav"},"topic":[65,62,187]},{"time":20101230423,"id":[66,18,60],"loc":[65,138,75],"line":{"line":"Loyal Nords are always welcome here. Anyone else better watch their step.","wav":"Sound\\Voice\\Guard Dialogue Overhaul.esp\\MaleGuard\\DialogueGuardsGeneral__00014B66_1.wav"},"topic":[66,189,221]},{"time":20101230431,"id":[69,202,194],"loc":[65,138,75],"line":{"line":"You hear that? I swear there's something out there... in the dark.","wav":"Sound\\Voice\\Civil War Lines Expansion.esp\\MaleNordCommander\\CivilWarLi_CivilWarLinesEx_000008E1_1.wav"},"topic":[1,149,200]},{"time":20101230437,"id":[65,158,2],"loc":[66,38,170],"line":{"line":"Welcome to the Vilemyr Inn. If there's anything I can get you, just let me know.","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\WITavern__000DBAF4_1.wav"},"topic":[77,238,131]},{"time":20101230442,"id":[1,151,122],"loc":[66,38,170],"line":{"line":"Skyrim certainly has its fair share of inns.","wav":"Sound\\Voice\\CitizensComplete.esp\\CoT_Carius\\Citizens_C_Citizens_Carius_0000D27D_1.wav"},"topic":[1,151,123]},{"time":20101230442,"id":[65,158,2],"loc":[66,38,170],"line":{"line":"If you're headed up to the monastery, watch your step... it's a long way down.","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\DialogueIv_DialogueIvarste_000DAAF1_1.wav"},"topic":[77,166,253]},{"time":20101230443,"id":[65,158,2],"loc":[66,38,170],"line":{"line":"I'll show you to your room. Right this way.","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\WIRentRoomWalkTo__000A3C4A_1.wav"},"topic":[74,60,72]},{"time":20101230449,"id":[1,151,122],"loc":[66,38,170],"line":{"line":"This place almost reminds me of my homeland. Almost.","wav":"Sound\\Voice\\CitizensComplete.esp\\CoT_Carius\\Citizens_C_Citizens_Carius_0000D27C_1.wav"},"topic":[1,151,123]},{"time":20101230450,"id":[65,158,3],"loc":[66,38,170],"line":{"line":"I heard the Gourmet is hiding out somewhere in Skyrim. You know, fella who wrote that cookbook.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleNord\\DialogueGuardsGeneral__000D3D67_1.wav"},"topic":[66,189,221]},{"time":20101230452,"id":[0,43,107],"loc":[66,38,170],"line":{"line":"Do not give your trust blindly, stranger, it will come back to bite you.","wav":"Sound\\Voice\\3DNPC.esp\\DarRakkiVoice\\DialogueDa_DialogueDarRakk_002B7C68_1.wav"},"topic":[1,151,124]},{"time":20101230454,"id":[65,158,3],"loc":[66,38,170],"line":{"line":"A pleasant journey, milady.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleNord\\DialogueIv_DialogueIvarste_000DAAF4_1.wav"},"topic":[77,166,253]},{"time":20101230455,"id":[0,25,176],"loc":[66,38,170],"line":{"line":"The road takes you many places, but sometimes it's best to pave your own.","wav":"Sound\\Voice\\3DNPC.esp\\HagraviVoice\\DialogueHa_DialogueHagravi_002A78A2_1.wav"},"topic":[1,151,125]},{"time":20101230501,"id":[65,158,2],"loc":[66,38,170],"line":{"line":"Let me know if there's anything else you need.","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\WIRentRoomWalkTo__000A3C49_1.wav"},"topic":[74,60,71]},{"time":20101230508,"id":[70,90,179],"loc":[66,38,170],"line":{"line":"Just get out of my way, I've got work to do.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCondescending\\DialogueIv_DialogueIvarste_000DAB02_1.wav"},"topic":[77,166,253]},{"time":20101230912,"id":[65,158,2],"loc":[66,38,170],"line":{"line":"Lynly, would you mind taking care of the customer please?","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\WITavern__000DEE87_1.wav"},"topic":[77,238,128]},{"time":20101230913,"id":[65,158,3],"loc":[66,38,170],"line":{"line":"No problem.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleNord\\WITavern__000DEE8A_1.wav"},"topic":[77,238,127]},{"time":20101231238,"id":[65,176,133],"loc":[65,145,124],"line":{"line":"Hmm hmm.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCommoner\\DialogueGe_DialogueGeneric_000854CE_1.wav"},"topic":[65,64,254]},{"time":20101231252,"id":[128,38,177],"loc":[64,150,72],"line":{"line":"Then I guess that's your last request, fool!","wav":"Sound\\Voice\\Skyrim.esm\\MaleArgonian\\WERJ02_WERJ02NoMoney_000B8167_1.wav"},"topic":[75,129,86]},{"time":20101231253,"id":[128,38,177],"loc":[64,150,72],"line":{"line":"You're as good as dead!","wav":"Sound\\Voice\\Skyrim.esm\\MaleArgonian\\DialogueGeneric__0006CED5_1.wav"},"topic":[65,193,198]},{"time":20101231254,"id":[128,38,177],"loc":[64,150,72],"line":{"line":"Oof!","wav":"Sound\\Voice\\Skyrim.esm\\MaleArgonian\\DialogueGeneric__00042ED2_1.wav"},"topic":[65,62,187]},{"time":20101231255,"id":[128,38,177],"loc":[64,150,72],"line":{"line":"This what you want?","wav":"Sound\\Voice\\Skyrim.esm\\MaleArgonian\\DialogueGeneric__0009687F_1.wav"},"topic":[65,62,227]},{"time":20101231257,"id":[128,38,177],"loc":[64,150,72],"line":{"line":"That your best? Huh?","wav":"Sound\\Voice\\Skyrim.esm\\MaleArgonian\\DialogueGeneric__000964FF_1.wav"},"topic":[65,62,187]},{"time":20101231257,"id":[128,38,177],"loc":[64,150,72],"line":{"line":"Mercy!","wav":"Sound\\Voice\\Skyrim.esm\\MaleArgonian\\DialogueGeneric__00017708_1.wav"},"topic":[65,63,48]},{"time":20101231257,"id":[128,38,177],"loc":[64,150,72],"line":{"line":"Agh...","wav":"Sound\\Voice\\Skyrim.esm\\MaleArgonian\\DialogueGeneric__0002E357_1.wav"},"topic":[65,62,228]},{"time":20101231604,"id":[0,136,247],"loc":[64,149,237],"line":{"line":"Hmm hmm.","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\DialogueGe_DialogueGeneric_000854CE_1.wav"},"topic":[65,64,254]},{"time":20101231611,"id":[0,150,82],"loc":[65,146,193],"line":{"line":"Gods... damn you!","wav":"Sound\\Voice\\Skyrim.esm\\MaleKhajiit\\DialogueGeneric__00096848_1.wav"},"topic":[65,62,227]},{"time":20101231612,"id":[0,150,82],"loc":[65,146,193],"line":{"line":"Nuh...","wav":"Sound\\Voice\\Skyrim.esm\\MaleKhajiit\\DialogueGeneric__00096502_1.wav"},"topic":[65,62,228]},{"time":20101231617,"id":[67,247,184],"loc":[65,146,193],"line":{"line":"Now you're mine!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleEvenToned\\DialogueGeneric__0006CB18_1.wav"},"topic":[65,193,199]},{"time":20101231618,"id":[67,247,184],"loc":[65,146,193],"line":{"line":"Die, damn you!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleEvenToned\\DialogueGeneric__00096838_1.wav"},"topic":[65,62,227]},{"time":20101231619,"id":[67,247,184],"loc":[65,146,193],"line":{"line":"Fool, I will see you dead!","wav":"Sound\\Voice\\Bandit Lines Expansion.esp\\FemaleEvenToned\\BanditLine_BLE_Taunt_000008A6_1.wav"},"topic":[1,236,159]},{"time":20101231619,"id":[0,150,56],"loc":[65,146,193],"line":{"line":"Fool! I'll have your blood!","wav":"Sound\\Voice\\Bandit Lines Expansion.esp\\MaleCommoner\\BanditLine_BLE_Taunt_000008FE_1.wav"},"topic":[1,236,159]},{"time":20101231621,"id":[67,247,184],"loc":[65,146,193],"line":{"line":"Time to die, hero!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleEvenToned\\DialogueCo_DCETAttack_000B876B_1.wav"},"topic":[75,135,106]},{"time":20101231624,"id":[67,247,184],"loc":[65,146,193],"line":{"line":"Grrargh!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleEvenToned\\DialogueGeneric__00013EEF_1.wav"},"topic":[65,62,227]},{"time":20101231625,"id":[67,247,184],"loc":[65,146,193],"line":{"line":"It's... nothing...","wav":"Sound\\Voice\\Skyrim.esm\\FemaleEvenToned\\DialogueGeneric__00096500_1.wav"},"topic":[65,62,187]},{"time":20101231626,"id":[67,247,184],"loc":[65,146,193],"line":{"line":"Nargh!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleEvenToned\\DialogueGeneric__00042ED3_1.wav"},"topic":[65,62,187]},{"time":20101231626,"id":[67,247,184],"loc":[65,146,193],"line":{"line":"Nuh...","wav":"Sound\\Voice\\Skyrim.esm\\FemaleEvenToned\\DialogueGeneric__00096502_1.wav"},"topic":[65,62,228]},{"time":20101231626,"id":[0,150,56],"loc":[65,146,193],"line":{"line":"Damn you...","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\DialogueGeneric__000494AB_1.wav"},"topic":[68,102,72]},{"time":20101231630,"id":[0,150,56],"loc":[65,146,193],"line":{"line":"You won't get the best of me!","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\DialogueGeneric__000494A5_1.wav"},"topic":[68,102,72]},{"time":20101231630,"id":[0,150,56],"loc":[65,146,193],"line":{"line":"Weergh!","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\DialogueGeneric__00042ED5_1.wav"},"topic":[65,62,187]},{"time":20101231630,"id":[0,150,56],"loc":[65,146,193],"line":{"line":"Yeagh!","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\DialogueGeneric__00013EF7_1.wav"},"topic":[65,62,187]},{"time":20101231631,"id":[0,150,56],"loc":[65,146,193],"line":{"line":"Agghh! ","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\DialogueGeneric__00017702_1.wav"},"topic":[65,63,48]}]