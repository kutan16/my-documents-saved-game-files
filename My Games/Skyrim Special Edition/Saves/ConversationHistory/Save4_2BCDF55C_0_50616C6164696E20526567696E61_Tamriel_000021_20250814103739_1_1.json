[{"time":20101230106,"id":[128,22,183],"loc":[64,152,23],"line":{"line":"Come along, no more stops, we need to find our way to Solitude.","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\WEDL03__000B813D_1.wav"},"topic":[75,129,58]},{"time":20101230108,"id":[128,22,178],"loc":[64,152,23],"line":{"line":"Why are we even going to a wedding at this far flung end of the Empire anyway?","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCoward\\WEDL03__000B813C_1.wav"},"topic":[75,129,57]},{"time":20101230109,"id":[128,22,126],"loc":[64,152,23],"line":{"line":"Hmm hmm.","wav":"Sound\\Voice\\Skyrim.esm\\MaleYoungEager\\DialogueGe_DialogueGeneric_000854CE_1.wav"},"topic":[65,64,254]},{"time":20101230110,"id":[128,22,178],"loc":[64,152,23],"line":{"line":"Ugh. Speak to my husband, if you must.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCoward\\WEDL03_WEDL03SaloniaDialog_000B9166_1.wav"},"topic":[75,144,189]},{"time":20101230111,"id":[128,22,183],"loc":[64,152,23],"line":{"line":"I told you, it's the wedding of Vittoria Vici, an extremely well connected merchant with the East Empire Company. The Emperor's cousin? Remember?","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\WEDL03__000B813B_1.wav"},"topic":[75,129,56]},{"time":20101230113,"id":[128,22,183],"loc":[64,152,23],"line":{"line":"Indeed. If we ever get there.","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\WEDL03_WEDL03Goodbye01_000B9104_1.wav"},"topic":[75,144,200]},{"time":20101230116,"id":[128,22,183],"loc":[64,151,247],"line":{"line":"Hopefully these gifts will put us in her good graces, secure that import deal, and lead the way to an audience with the Emperor. ","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\WEDL03__000B813E_1.wav"},"topic":[75,129,55]}]