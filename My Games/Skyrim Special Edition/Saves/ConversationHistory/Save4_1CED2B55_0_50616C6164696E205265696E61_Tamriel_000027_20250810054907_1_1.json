[{"time":20107101505,"id":[0,137,7],"loc":[65,49,99],"line":{"line":"What I would give to see her again...","wav":"Sound\\Voice\\CitizensComplete.esp\\CoT_Malik\\Citizens_M_Citizens_MalikD_00060BD3_1.wav"},"topic":[1,136,101]},{"time":20107101534,"id":[0,137,7],"loc":[65,49,99],"line":{"line":"I was never going to die in bed anyway...","wav":"Sound\\Voice\\CitizensComplete.esp\\CoT_Malik\\Citizens_M_Citizens_MalikD_00060BD2_1.wav"},"topic":[1,136,101]},{"time":20107101545,"id":[67,85,12],"loc":[65,49,99],"line":{"line":"Hmm hmm.","wav":"Sound\\Voice\\Skyrim.esm\\MaleDrunk\\DialogueGe_DialogueGeneric_000854CE_1.wav"},"topic":[65,64,254]},{"time":20107101557,"id":[65,52,133],"loc":[65,203,140],"line":{"line":"Orgnar.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleUniqueDelphine\\DialogueRiverwood_Revised__000BCCC4_1.wav"},"topic":[75,199,105]},{"time":20107101557,"id":[65,52,134],"loc":[65,203,140],"line":{"line":"Hard not to.","wav":"Sound\\Voice\\Skyrim.esm\\MaleBrute\\DialogueRiverwood_Revised__000BCCBF_1.wav"},"topic":[75,197,218]},{"time":20107101558,"id":[65,52,133],"loc":[65,203,140],"line":{"line":"The ale is going bad. We need to get a new batch.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleUniqueDelphine\\DialogueRiverwood_Revised__000BCCB1_1.wav"},"topic":[75,197,211]},{"time":20107101559,"id":[65,52,133],"loc":[65,203,140],"line":{"line":"Did you hear me?","wav":"Sound\\Voice\\Skyrim.esm\\FemaleUniqueDelphine\\DialogueRiverwood_Revised__000BCCB0_1.wav"},"topic":[75,197,210]},{"time":20107101600,"id":[65,52,134],"loc":[65,203,140],"line":{"line":"Yep. Ale's going bad.","wav":"Sound\\Voice\\Skyrim.esm\\MaleBrute\\DialogueRiverwood_Revised__000BCC9C_1.wav"},"topic":[75,197,206]},{"time":20107101602,"id":[65,52,133],"loc":[65,203,140],"line":{"line":"I guess you don't have potatoes in your ears after all. Just make sure we get a fresh batch in soon.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleUniqueDelphine\\DialogueRiverwood_Revised__000BCAF3_1.wav"},"topic":[75,197,192]},{"time":20107101603,"id":[65,52,134],"loc":[65,203,140],"line":{"line":"Come on in. Just stoked the fire. Take a seat and get the cold out.","wav":"Sound\\Voice\\Skyrim.esm\\MaleBrute\\WITavern__000C7916_1.wav"},"topic":[77,238,131]},{"time":20107101609,"id":[65,52,133],"loc":[65,203,140],"line":{"line":"I'm the innkeeper. It's my business to keep track of strangers.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleUniqueDelphine\\DialogueRiverwood_Revised__0004544C_1.wav"},"topic":[68,83,233]},{"time":20107101611,"id":[65,52,134],"loc":[65,203,140],"line":{"line":"Be careful!","wav":"Sound\\Voice\\Skyrim.esm\\MaleBrute\\DialogueGe_DialogueGeneric_0006CB2C_1.wav"},"topic":[65,66,174]},{"time":20107102033,"id":[65,52,145],"loc":[65,203,140],"line":{"line":"A pint of your finest mead.","wav":"Sound\\Voice\\Skyrim.esm\\MaleYoungEager\\DialogueRi__00098E4E_1.wav"},"topic":[73,142,61]},{"time":20107102033,"id":[65,52,134],"loc":[65,203,140],"line":{"line":"Coming right up.","wav":"Sound\\Voice\\Skyrim.esm\\MaleBrute\\DialogueRi__00098E52_1.wav"},"topic":[73,142,60]},{"time":20107102114,"id":[65,52,140],"loc":[65,49,99],"line":{"line":"All right, then.","wav":"Sound\\Voice\\Skyrim.esm\\MaleEvenToned\\DialogueGe_DialogueGeneric_000854CD_1.wav"},"topic":[65,64,254]},{"time":20107102119,"id":[65,52,136],"loc":[65,203,141],"line":{"line":"Well, one of us has to do something!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleYoungEager\\MS13LucanCamillaScene__0003834A_1.wav"},"topic":[67,130,183]},{"time":20107102120,"id":[65,52,136],"loc":[65,203,141],"line":{"line":"Watch what you're doing.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleYoungEager\\DialogueGe_DialogueGeneric_000142BA_1.wav"},"topic":[65,66,174]},{"time":20107102121,"id":[65,52,135],"loc":[65,203,141],"line":{"line":"I said no! No adventures, no theatrics, no thief-chasing!","wav":"Sound\\Voice\\Skyrim.esm\\MaleSlyCynical\\MS13LucanCamillaScene__0001725E_1.wav"},"topic":[65,114,49]},{"time":20107102122,"id":[65,52,136],"loc":[65,203,141],"line":{"line":"Well, what are you going to do then, huh? Let's hear it!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleYoungEager\\MS13LucanCamillaScene__000382C5_1.wav"},"topic":[67,130,92]},{"time":20107102123,"id":[65,52,135],"loc":[65,203,141],"line":{"line":"We are done talking about this.","wav":"Sound\\Voice\\Skyrim.esm\\MaleSlyCynical\\MS13LucanCamillaScene__000382B8_1.wav"},"topic":[67,130,93]},{"time":20107102124,"id":[65,52,135],"loc":[65,203,141],"line":{"line":"Oh, a customer. Sorry you had to hear that.","wav":"Sound\\Voice\\Skyrim.esm\\MaleSlyCynical\\MS13LucanCamillaScene__000BCD17_1.wav"},"topic":[75,205,10]},{"time":20107102134,"id":[65,52,135],"loc":[65,203,141],"line":{"line":"You could? I've got some coin coming in from my last shipment. It's yours if you bring my claw back.","wav":"Sound\\Voice\\Skyrim.esm\\MaleSlyCynical\\MS13_MS13LucanVolunteerTop_0008AFA2_1.wav"},"topic":[69,212,111]},{"time":20107102136,"id":[65,52,136],"loc":[65,49,99],"line":{"line":"So this is your plan, Lucan?","wav":"Sound\\Voice\\Skyrim.esm\\FemaleYoungEager\\MS13__000382BE_1.wav"},"topic":[67,129,74]},{"time":20107102138,"id":[65,52,135],"loc":[65,49,99],"line":{"line":"Yes. So now you don't have to go, do you?","wav":"Sound\\Voice\\Skyrim.esm\\MaleSlyCynical\\MS13__00038309_1.wav"},"topic":[67,129,73]},{"time":20107102139,"id":[65,52,136],"loc":[65,49,99],"line":{"line":"Oh really? Well I think your new helper here needs a guide.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleYoungEager\\MS13__000382C3_1.wav"},"topic":[67,129,72]},{"time":20107102141,"id":[65,52,135],"loc":[65,49,99],"line":{"line":"Wh- no... I... Oh, by the Eight, fine. But only to the edge of town!","wav":"Sound\\Voice\\Skyrim.esm\\MaleSlyCynical\\MS13__000382B9_1.wav"},"topic":[67,129,71]},{"time":20107102149,"id":[65,52,136],"loc":[65,49,99],"line":{"line":"All right, then.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleYoungEager\\DialogueGe_DialogueGeneric_000854CD_1.wav"},"topic":[65,64,254]},{"time":20107102154,"id":[65,52,134],"loc":[65,203,140],"line":{"line":"Welcome. Let me know if you want anything... think I got a clean mug around here somewhere.","wav":"Sound\\Voice\\Skyrim.esm\\MaleBrute\\WITavern__000C7B0D_1.wav"},"topic":[77,238,131]}]