[{"time":20107311512,"id":[65,52,132],"loc":[65,49,99],"line":{"line":"All right, then.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleChild\\DialogueGe_DialogueGeneric_000854CD_1.wav"},"topic":[65,64,254]},{"time":20107311515,"id":[65,183,71],"loc":[65,49,99],"line":{"line":"Cause trouble in Whiterun, and I'll haul you into the Dragonsreach dungeon myself.","wav":"Sound\\Voice\\Guard Dialogue Overhaul.esp\\MaleNordCommander\\DialogueGuardsGeneral__00014B68_1.wav"},"topic":[66,189,221]},{"time":20107311516,"id":[65,183,71],"loc":[65,49,99],"line":{"line":"Let me guess - someone stole your sweetroll...","wav":"Sound\\Voice\\Skyrim.esm\\MaleNordCommander\\DialogueGuardsGeneral__0002BE10_1.wav"},"topic":[66,189,221]},{"time":20107311531,"id":[65,52,139],"loc":[65,49,99],"line":{"line":"Hey, no fair! Get her, Stump!","wav":"Sound\\Voice\\Skyrim.esm\\MaleChild\\DialogueRi__000340BA_1.wav"},"topic":[67,64,176]},{"time":20107311536,"id":[0,135,227],"loc":[65,49,99],"line":{"line":"Until next time.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleDarkElf\\DialogueGe_DialogueGeneric_00087935_1.wav"},"topic":[65,64,254]},{"time":20107311537,"id":[67,85,12],"loc":[65,49,99],"line":{"line":"What do you want?","wav":"Sound\\Voice\\Skyrim.esm\\MaleDrunk\\DialogueGe_DialogueGeneric_000A9B37_1.wav"},"topic":[65,66,181]},{"time":20107311538,"id":[67,85,12],"loc":[65,49,99],"line":{"line":"Need something?","wav":"Sound\\Voice\\Skyrim.esm\\MaleDrunk\\DialogueGe_DialogueGeneric_00087947_1.wav"},"topic":[65,66,181]},{"time":20107311539,"id":[65,52,136],"loc":[65,203,141],"line":{"line":"Well, one of us has to do something!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleYoungEager\\MS13LucanCamillaScene__0003834A_1.wav"},"topic":[67,130,183]},{"time":20107311540,"id":[65,52,136],"loc":[65,203,141],"line":{"line":"Be careful!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleYoungEager\\DialogueGe_DialogueGeneric_0006CB2C_1.wav"},"topic":[65,66,174]},{"time":20107311541,"id":[65,52,135],"loc":[65,203,141],"line":{"line":"I said no! No adventures, no theatrics, no thief-chasing!","wav":"Sound\\Voice\\Skyrim.esm\\MaleSlyCynical\\MS13LucanCamillaScene__0001725E_1.wav"},"topic":[65,114,49]},{"time":20107311542,"id":[65,52,136],"loc":[65,203,141],"line":{"line":"Well, what are you going to do then, huh? Let's hear it!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleYoungEager\\MS13LucanCamillaScene__000382C5_1.wav"},"topic":[67,130,92]},{"time":20107311543,"id":[65,52,135],"loc":[65,203,141],"line":{"line":"We are done talking about this.","wav":"Sound\\Voice\\Skyrim.esm\\MaleSlyCynical\\MS13LucanCamillaScene__000382B8_1.wav"},"topic":[67,130,93]},{"time":20107311545,"id":[65,52,135],"loc":[65,203,141],"line":{"line":"Oh, a customer. Sorry you had to hear that.","wav":"Sound\\Voice\\Skyrim.esm\\MaleSlyCynical\\MS13LucanCamillaScene__000BCD17_1.wav"},"topic":[75,205,10]},{"time":20107311552,"id":[65,52,135],"loc":[65,203,141],"line":{"line":"You could? I've got some coin coming in from my last shipment. It's yours if you bring my claw back.","wav":"Sound\\Voice\\Skyrim.esm\\MaleSlyCynical\\MS13_MS13LucanVolunteerTop_0008AFA2_1.wav"},"topic":[69,212,111]},{"time":20107311553,"id":[65,52,136],"loc":[65,203,141],"line":{"line":"Maybe you could talk some sense into my pig-headed brother.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleYoungEager\\MS13__000176A6_1.wav"},"topic":[67,150,34]},{"time":20107311554,"id":[65,52,135],"loc":[65,203,141],"line":{"line":"Now, if you're going to get those thieves, you should head to Bleak Falls Barrow, northwest of town.","wav":"Sound\\Voice\\Skyrim.esm\\MaleSlyCynical\\MS13__0001AACA_1.wav"},"topic":[65,168,37]},{"time":20107311555,"id":[65,52,136],"loc":[65,203,141],"line":{"line":"So this is your plan, Lucan?","wav":"Sound\\Voice\\Skyrim.esm\\FemaleYoungEager\\MS13__000382BE_1.wav"},"topic":[67,129,74]},{"time":20107311555,"id":[65,52,136],"loc":[65,203,141],"line":{"line":"Be careful!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleYoungEager\\DialogueGe_DialogueGeneric_0006CB2C_1.wav"},"topic":[65,66,174]},{"time":20107311556,"id":[65,52,135],"loc":[65,203,141],"line":{"line":"Yes. So now you don't have to go, do you?","wav":"Sound\\Voice\\Skyrim.esm\\MaleSlyCynical\\MS13__00038309_1.wav"},"topic":[67,129,73]},{"time":20107311557,"id":[65,52,136],"loc":[65,203,141],"line":{"line":"Oh really? Well I think your new helper here needs a guide.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleYoungEager\\MS13__000382C3_1.wav"},"topic":[67,129,72]},{"time":20107311559,"id":[65,52,135],"loc":[65,203,141],"line":{"line":"Wh- no... I... Oh, by the Eight, fine. But only to the edge of town!","wav":"Sound\\Voice\\Skyrim.esm\\MaleSlyCynical\\MS13__000382B9_1.wav"},"topic":[67,129,71]},{"time":20107311601,"id":[65,52,136],"loc":[65,203,141],"line":{"line":"This way.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleYoungEager\\MS13__000176A7_1.wav"},"topic":[67,150,34]},{"time":20107311613,"id":[65,52,145],"loc":[65,203,141],"line":{"line":"Then what are you wasting my time for?","wav":"Sound\\Voice\\TheChoiceIsYours.esp\\MaleYoungEager\\FreeformRi_FreeformRiverwo_00013063_2.wav"},"topic":[1,141,187]},{"time":20107311616,"id":[65,52,136],"loc":[65,49,99],"line":{"line":"We have to go through town and across the bridge to get to Bleak Falls Barrow.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleYoungEager\\MS13__0002E2C8_2.wav"},"topic":[66,226,199]},{"time":20107311617,"id":[65,52,145],"loc":[65,49,99],"line":{"line":"That letter ought to convince Camilla to never speak to Faendal ever again.","wav":"Sound\\Voice\\TheChoiceIsYours.esp\\MaleYoungEager\\FreeformRi_FreeformRiverwo_00013062_1.wav"},"topic":[1,141,188]},{"time":20107311619,"id":[65,52,136],"loc":[65,49,99],"line":{"line":"Those thieves must be mad, hiding out there. Those old crypts are filled with nothing but traps, trolls, and who knows what else!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleYoungEager\\MS13__00038308_2.wav"},"topic":[67,129,66]},{"time":20107311630,"id":[65,52,133],"loc":[65,203,140],"line":{"line":"Orgnar.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleUniqueDelphine\\DialogueRiverwood_Revised__000BCCC4_1.wav"},"topic":[75,199,105]},{"time":20107311631,"id":[65,52,134],"loc":[65,203,140],"line":{"line":"Hard not to.","wav":"Sound\\Voice\\Skyrim.esm\\MaleBrute\\DialogueRiverwood_Revised__000BCCBF_1.wav"},"topic":[75,197,218]},{"time":20107311632,"id":[65,52,133],"loc":[65,203,140],"line":{"line":"The ale is going bad. We need to get a new batch.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleUniqueDelphine\\DialogueRiverwood_Revised__000BCCB1_1.wav"},"topic":[75,197,211]},{"time":20107311633,"id":[65,52,133],"loc":[65,203,140],"line":{"line":"Did you hear me?","wav":"Sound\\Voice\\Skyrim.esm\\FemaleUniqueDelphine\\DialogueRiverwood_Revised__000BCCB0_1.wav"},"topic":[75,197,210]},{"time":20107311634,"id":[65,52,134],"loc":[65,203,140],"line":{"line":"Yep. Ale's going bad.","wav":"Sound\\Voice\\Skyrim.esm\\MaleBrute\\DialogueRiverwood_Revised__000BCC9C_1.wav"},"topic":[75,197,206]},{"time":20107311635,"id":[65,52,133],"loc":[65,203,140],"line":{"line":"I guess you don't have potatoes in your ears after all. Just make sure we get a fresh batch in soon.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleUniqueDelphine\\DialogueRiverwood_Revised__000BCAF3_1.wav"},"topic":[75,197,192]},{"time":20107311637,"id":[65,52,134],"loc":[65,203,140],"line":{"line":"Welcome. Let me know if you want anything... think I got a clean mug around here somewhere.","wav":"Sound\\Voice\\Skyrim.esm\\MaleBrute\\WITavern__000C7B0D_1.wav"},"topic":[77,238,131]},{"time":20107311724,"id":[65,52,140],"loc":[65,49,99],"line":{"line":"Until next time.","wav":"Sound\\Voice\\Skyrim.esm\\MaleEvenToned\\DialogueGe_DialogueGeneric_00087935_1.wav"},"topic":[65,64,254]},{"time":20107311728,"id":[65,52,134],"loc":[65,203,140],"line":{"line":"Welcome. Let me know if you want anything... think I got a clean mug around here somewhere.","wav":"Sound\\Voice\\Skyrim.esm\\MaleBrute\\WITavern__000C7B0D_1.wav"},"topic":[77,238,131]}]