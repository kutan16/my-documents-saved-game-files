[{"time":20101230106,"id":[128,22,183],"loc":[64,152,23],"line":{"line":"Come along, no more stops, we need to find our way to Solitude.","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\WEDL03__000B813D_1.wav"},"topic":[75,129,58]},{"time":20101230108,"id":[128,22,178],"loc":[64,152,23],"line":{"line":"Why are we even going to a wedding at this far flung end of the Empire anyway?","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCoward\\WEDL03__000B813C_1.wav"},"topic":[75,129,57]},{"time":20101230109,"id":[128,22,126],"loc":[64,152,23],"line":{"line":"Hmm hmm.","wav":"Sound\\Voice\\Skyrim.esm\\MaleYoungEager\\DialogueGe_DialogueGeneric_000854CE_1.wav"},"topic":[65,64,254]},{"time":20101230110,"id":[128,22,178],"loc":[64,152,23],"line":{"line":"Ugh. Speak to my husband, if you must.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCoward\\WEDL03_WEDL03SaloniaDialog_000B9166_1.wav"},"topic":[75,144,189]},{"time":20101230111,"id":[128,22,183],"loc":[64,152,23],"line":{"line":"I told you, it's the wedding of Vittoria Vici, an extremely well connected merchant with the East Empire Company. The Emperor's cousin? Remember?","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\WEDL03__000B813B_1.wav"},"topic":[75,129,56]},{"time":20101230113,"id":[128,22,183],"loc":[64,152,23],"line":{"line":"Indeed. If we ever get there.","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\WEDL03_WEDL03Goodbye01_000B9104_1.wav"},"topic":[75,144,200]},{"time":20101230116,"id":[128,22,183],"loc":[64,151,247],"line":{"line":"Hopefully these gifts will put us in her good graces, secure that import deal, and lead the way to an audience with the Emperor. ","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\WEDL03__000B813E_1.wav"},"topic":[75,129,55]},{"time":20101230143,"id":[128,22,183],"loc":[64,151,216],"line":{"line":"Don't bother me, peasant. I've had a long journey and paid too much coin on these gifts to be late to Vittoria's wedding.","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\WEDL03_WEDL03PlautisDialog_000B9106_1.wav"},"topic":[75,144,201]},{"time":20101230150,"id":[128,36,70],"loc":[64,151,184],"line":{"line":"I'm on my way to Solitude to join the Legion. A united Empire is better for everyone.","wav":"Sound\\Voice\\Skyrim.esm\\MaleDarkElf\\WEDL13__000BD749_1.wav"},"topic":[75,215,62]},{"time":20101230158,"id":[77,18,65],"loc":[64,151,185],"line":{"line":"Never should have come here...","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommonerAccented\\DialogueGeneric__000854C2_1.wav"},"topic":[65,193,198]},{"time":20101230200,"id":[77,18,68],"loc":[64,151,185],"line":{"line":"Hhyyaarargghhhh!","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\DialogueGeneric__00013EBC_1.wav"},"topic":[65,62,186]},{"time":20101230200,"id":[77,18,65],"loc":[64,151,185],"line":{"line":"Nyyarrggh!","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommonerAccented\\DialogueGeneric__00013EF1_1.wav"},"topic":[65,62,227]},{"time":20101230200,"id":[77,18,68],"loc":[64,151,185],"line":{"line":"Agh!","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\DialogueGeneric__0006F41E_1.wav"},"topic":[65,62,187]},{"time":20101230200,"id":[77,18,65],"loc":[64,151,185],"line":{"line":"Nargh!","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommonerAccented\\DialogueGeneric__00042ED3_1.wav"},"topic":[65,62,187]},{"time":20101230201,"id":[77,18,68],"loc":[64,151,185],"line":{"line":"Yeagh!","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\DialogueGeneric__00013EF7_1.wav"},"topic":[65,62,187]},{"time":20101230201,"id":[77,18,68],"loc":[64,151,185],"line":{"line":"Yeagh!","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\DialogueGeneric__00013EF7_1.wav"},"topic":[65,62,187]},{"time":20101230202,"id":[77,18,65],"loc":[64,151,185],"line":{"line":"Gods, no!","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommonerAccented\\DialogueGeneric__00017711_1.wav"},"topic":[65,62,187]},{"time":20101230423,"id":[66,18,60],"loc":[65,138,75],"line":{"line":"Loyal Nords are always welcome here. Anyone else better watch their step.","wav":"Sound\\Voice\\Guard Dialogue Overhaul.esp\\MaleGuard\\DialogueGuardsGeneral__00014B66_1.wav"},"topic":[66,189,221]},{"time":20101230431,"id":[69,202,194],"loc":[65,138,75],"line":{"line":"You hear that? I swear there's something out there... in the dark.","wav":"Sound\\Voice\\Civil War Lines Expansion.esp\\MaleNordCommander\\CivilWarLi_CivilWarLinesEx_000008E1_1.wav"},"topic":[1,149,200]},{"time":20101230437,"id":[65,158,2],"loc":[66,38,170],"line":{"line":"Welcome to the Vilemyr Inn. If there's anything I can get you, just let me know.","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\WITavern__000DBAF4_1.wav"},"topic":[77,238,131]},{"time":20101230442,"id":[1,151,122],"loc":[66,38,170],"line":{"line":"Skyrim certainly has its fair share of inns.","wav":"Sound\\Voice\\CitizensComplete.esp\\CoT_Carius\\Citizens_C_Citizens_Carius_0000D27D_1.wav"},"topic":[1,151,123]},{"time":20101230442,"id":[65,158,2],"loc":[66,38,170],"line":{"line":"If you're headed up to the monastery, watch your step... it's a long way down.","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\DialogueIv_DialogueIvarste_000DAAF1_1.wav"},"topic":[77,166,253]},{"time":20101230443,"id":[65,158,2],"loc":[66,38,170],"line":{"line":"I'll show you to your room. Right this way.","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\WIRentRoomWalkTo__000A3C4A_1.wav"},"topic":[74,60,72]},{"time":20101230449,"id":[1,151,122],"loc":[66,38,170],"line":{"line":"This place almost reminds me of my homeland. Almost.","wav":"Sound\\Voice\\CitizensComplete.esp\\CoT_Carius\\Citizens_C_Citizens_Carius_0000D27C_1.wav"},"topic":[1,151,123]},{"time":20101230450,"id":[65,158,3],"loc":[66,38,170],"line":{"line":"I heard the Gourmet is hiding out somewhere in Skyrim. You know, fella who wrote that cookbook.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleNord\\DialogueGuardsGeneral__000D3D67_1.wav"},"topic":[66,189,221]},{"time":20101230452,"id":[0,43,107],"loc":[66,38,170],"line":{"line":"Do not give your trust blindly, stranger, it will come back to bite you.","wav":"Sound\\Voice\\3DNPC.esp\\DarRakkiVoice\\DialogueDa_DialogueDarRakk_002B7C68_1.wav"},"topic":[1,151,124]},{"time":20101230454,"id":[65,158,3],"loc":[66,38,170],"line":{"line":"A pleasant journey, milady.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleNord\\DialogueIv_DialogueIvarste_000DAAF4_1.wav"},"topic":[77,166,253]},{"time":20101230455,"id":[0,25,176],"loc":[66,38,170],"line":{"line":"The road takes you many places, but sometimes it's best to pave your own.","wav":"Sound\\Voice\\3DNPC.esp\\HagraviVoice\\DialogueHa_DialogueHagravi_002A78A2_1.wav"},"topic":[1,151,125]},{"time":20101230501,"id":[65,158,2],"loc":[66,38,170],"line":{"line":"Let me know if there's anything else you need.","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\WIRentRoomWalkTo__000A3C49_1.wav"},"topic":[74,60,71]},{"time":20101230508,"id":[70,90,179],"loc":[66,38,170],"line":{"line":"Just get out of my way, I've got work to do.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCondescending\\DialogueIv_DialogueIvarste_000DAB02_1.wav"},"topic":[77,166,253]},{"time":20101230912,"id":[65,158,2],"loc":[66,38,170],"line":{"line":"Lynly, would you mind taking care of the customer please?","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\WITavern__000DEE87_1.wav"},"topic":[77,238,128]},{"time":20101230913,"id":[65,158,3],"loc":[66,38,170],"line":{"line":"No problem.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleNord\\WITavern__000DEE8A_1.wav"},"topic":[77,238,127]}]