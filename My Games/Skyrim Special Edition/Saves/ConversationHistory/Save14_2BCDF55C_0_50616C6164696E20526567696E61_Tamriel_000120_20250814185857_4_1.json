[{"time":20101230106,"id":[128,22,183],"loc":[64,152,23],"line":{"line":"Come along, no more stops, we need to find our way to Solitude.","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\WEDL03__000B813D_1.wav"},"topic":[75,129,58]},{"time":20101230108,"id":[128,22,178],"loc":[64,152,23],"line":{"line":"Why are we even going to a wedding at this far flung end of the Empire anyway?","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCoward\\WEDL03__000B813C_1.wav"},"topic":[75,129,57]},{"time":20101230109,"id":[128,22,126],"loc":[64,152,23],"line":{"line":"Hmm hmm.","wav":"Sound\\Voice\\Skyrim.esm\\MaleYoungEager\\DialogueGe_DialogueGeneric_000854CE_1.wav"},"topic":[65,64,254]},{"time":20101230110,"id":[128,22,178],"loc":[64,152,23],"line":{"line":"Ugh. Speak to my husband, if you must.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCoward\\WEDL03_WEDL03SaloniaDialog_000B9166_1.wav"},"topic":[75,144,189]},{"time":20101230111,"id":[128,22,183],"loc":[64,152,23],"line":{"line":"I told you, it's the wedding of Vittoria Vici, an extremely well connected merchant with the East Empire Company. The Emperor's cousin? Remember?","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\WEDL03__000B813B_1.wav"},"topic":[75,129,56]},{"time":20101230113,"id":[128,22,183],"loc":[64,152,23],"line":{"line":"Indeed. If we ever get there.","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\WEDL03_WEDL03Goodbye01_000B9104_1.wav"},"topic":[75,144,200]},{"time":20101230116,"id":[128,22,183],"loc":[64,151,247],"line":{"line":"Hopefully these gifts will put us in her good graces, secure that import deal, and lead the way to an audience with the Emperor. ","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\WEDL03__000B813E_1.wav"},"topic":[75,129,55]},{"time":20101230143,"id":[128,22,183],"loc":[64,151,216],"line":{"line":"Don't bother me, peasant. I've had a long journey and paid too much coin on these gifts to be late to Vittoria's wedding.","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\WEDL03_WEDL03PlautisDialog_000B9106_1.wav"},"topic":[75,144,201]},{"time":20101230150,"id":[128,36,70],"loc":[64,151,184],"line":{"line":"I'm on my way to Solitude to join the Legion. A united Empire is better for everyone.","wav":"Sound\\Voice\\Skyrim.esm\\MaleDarkElf\\WEDL13__000BD749_1.wav"},"topic":[75,215,62]},{"time":20101230158,"id":[77,18,65],"loc":[64,151,185],"line":{"line":"Never should have come here...","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommonerAccented\\DialogueGeneric__000854C2_1.wav"},"topic":[65,193,198]},{"time":20101230200,"id":[77,18,68],"loc":[64,151,185],"line":{"line":"Hhyyaarargghhhh!","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\DialogueGeneric__00013EBC_1.wav"},"topic":[65,62,186]},{"time":20101230200,"id":[77,18,65],"loc":[64,151,185],"line":{"line":"Nyyarrggh!","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommonerAccented\\DialogueGeneric__00013EF1_1.wav"},"topic":[65,62,227]},{"time":20101230200,"id":[77,18,68],"loc":[64,151,185],"line":{"line":"Agh!","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\DialogueGeneric__0006F41E_1.wav"},"topic":[65,62,187]},{"time":20101230200,"id":[77,18,65],"loc":[64,151,185],"line":{"line":"Nargh!","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommonerAccented\\DialogueGeneric__00042ED3_1.wav"},"topic":[65,62,187]},{"time":20101230201,"id":[77,18,68],"loc":[64,151,185],"line":{"line":"Yeagh!","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\DialogueGeneric__00013EF7_1.wav"},"topic":[65,62,187]},{"time":20101230201,"id":[77,18,68],"loc":[64,151,185],"line":{"line":"Yeagh!","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\DialogueGeneric__00013EF7_1.wav"},"topic":[65,62,187]},{"time":20101230202,"id":[77,18,65],"loc":[64,151,185],"line":{"line":"Gods, no!","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommonerAccented\\DialogueGeneric__00017711_1.wav"},"topic":[65,62,187]},{"time":20101230423,"id":[66,18,60],"loc":[65,138,75],"line":{"line":"Loyal Nords are always welcome here. Anyone else better watch their step.","wav":"Sound\\Voice\\Guard Dialogue Overhaul.esp\\MaleGuard\\DialogueGuardsGeneral__00014B66_1.wav"},"topic":[66,189,221]},{"time":20101230431,"id":[69,202,194],"loc":[65,138,75],"line":{"line":"You hear that? I swear there's something out there... in the dark.","wav":"Sound\\Voice\\Civil War Lines Expansion.esp\\MaleNordCommander\\CivilWarLi_CivilWarLinesEx_000008E1_1.wav"},"topic":[1,149,200]},{"time":20101230437,"id":[65,158,2],"loc":[66,38,170],"line":{"line":"Welcome to the Vilemyr Inn. If there's anything I can get you, just let me know.","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\WITavern__000DBAF4_1.wav"},"topic":[77,238,131]},{"time":20101230442,"id":[1,151,122],"loc":[66,38,170],"line":{"line":"Skyrim certainly has its fair share of inns.","wav":"Sound\\Voice\\CitizensComplete.esp\\CoT_Carius\\Citizens_C_Citizens_Carius_0000D27D_1.wav"},"topic":[1,151,123]},{"time":20101230442,"id":[65,158,2],"loc":[66,38,170],"line":{"line":"If you're headed up to the monastery, watch your step... it's a long way down.","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\DialogueIv_DialogueIvarste_000DAAF1_1.wav"},"topic":[77,166,253]},{"time":20101230443,"id":[65,158,2],"loc":[66,38,170],"line":{"line":"I'll show you to your room. Right this way.","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\WIRentRoomWalkTo__000A3C4A_1.wav"},"topic":[74,60,72]},{"time":20101230449,"id":[1,151,122],"loc":[66,38,170],"line":{"line":"This place almost reminds me of my homeland. Almost.","wav":"Sound\\Voice\\CitizensComplete.esp\\CoT_Carius\\Citizens_C_Citizens_Carius_0000D27C_1.wav"},"topic":[1,151,123]},{"time":20101230450,"id":[65,158,3],"loc":[66,38,170],"line":{"line":"I heard the Gourmet is hiding out somewhere in Skyrim. You know, fella who wrote that cookbook.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleNord\\DialogueGuardsGeneral__000D3D67_1.wav"},"topic":[66,189,221]},{"time":20101230452,"id":[0,43,107],"loc":[66,38,170],"line":{"line":"Do not give your trust blindly, stranger, it will come back to bite you.","wav":"Sound\\Voice\\3DNPC.esp\\DarRakkiVoice\\DialogueDa_DialogueDarRakk_002B7C68_1.wav"},"topic":[1,151,124]},{"time":20101230454,"id":[65,158,3],"loc":[66,38,170],"line":{"line":"A pleasant journey, milady.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleNord\\DialogueIv_DialogueIvarste_000DAAF4_1.wav"},"topic":[77,166,253]},{"time":20101230455,"id":[0,25,176],"loc":[66,38,170],"line":{"line":"The road takes you many places, but sometimes it's best to pave your own.","wav":"Sound\\Voice\\3DNPC.esp\\HagraviVoice\\DialogueHa_DialogueHagravi_002A78A2_1.wav"},"topic":[1,151,125]},{"time":20101230501,"id":[65,158,2],"loc":[66,38,170],"line":{"line":"Let me know if there's anything else you need.","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\WIRentRoomWalkTo__000A3C49_1.wav"},"topic":[74,60,71]},{"time":20101230508,"id":[70,90,179],"loc":[66,38,170],"line":{"line":"Just get out of my way, I've got work to do.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCondescending\\DialogueIv_DialogueIvarste_000DAB02_1.wav"},"topic":[77,166,253]},{"time":20101230912,"id":[65,158,2],"loc":[66,38,170],"line":{"line":"Lynly, would you mind taking care of the customer please?","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\WITavern__000DEE87_1.wav"},"topic":[77,238,128]},{"time":20101230913,"id":[65,158,3],"loc":[66,38,170],"line":{"line":"No problem.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleNord\\WITavern__000DEE8A_1.wav"},"topic":[77,238,127]},{"time":20101231238,"id":[65,176,133],"loc":[65,145,124],"line":{"line":"Hmm hmm.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCommoner\\DialogueGe_DialogueGeneric_000854CE_1.wav"},"topic":[65,64,254]},{"time":20101231252,"id":[128,38,177],"loc":[64,150,72],"line":{"line":"Then I guess that's your last request, fool!","wav":"Sound\\Voice\\Skyrim.esm\\MaleArgonian\\WERJ02_WERJ02NoMoney_000B8167_1.wav"},"topic":[75,129,86]},{"time":20101231253,"id":[128,38,177],"loc":[64,150,72],"line":{"line":"You're as good as dead!","wav":"Sound\\Voice\\Skyrim.esm\\MaleArgonian\\DialogueGeneric__0006CED5_1.wav"},"topic":[65,193,198]},{"time":20101231254,"id":[128,38,177],"loc":[64,150,72],"line":{"line":"Oof!","wav":"Sound\\Voice\\Skyrim.esm\\MaleArgonian\\DialogueGeneric__00042ED2_1.wav"},"topic":[65,62,187]},{"time":20101231255,"id":[128,38,177],"loc":[64,150,72],"line":{"line":"This what you want?","wav":"Sound\\Voice\\Skyrim.esm\\MaleArgonian\\DialogueGeneric__0009687F_1.wav"},"topic":[65,62,227]},{"time":20101231257,"id":[128,38,177],"loc":[64,150,72],"line":{"line":"That your best? Huh?","wav":"Sound\\Voice\\Skyrim.esm\\MaleArgonian\\DialogueGeneric__000964FF_1.wav"},"topic":[65,62,187]},{"time":20101231257,"id":[128,38,177],"loc":[64,150,72],"line":{"line":"Mercy!","wav":"Sound\\Voice\\Skyrim.esm\\MaleArgonian\\DialogueGeneric__00017708_1.wav"},"topic":[65,63,48]},{"time":20101231257,"id":[128,38,177],"loc":[64,150,72],"line":{"line":"Agh...","wav":"Sound\\Voice\\Skyrim.esm\\MaleArgonian\\DialogueGeneric__0002E357_1.wav"},"topic":[65,62,228]},{"time":20101231604,"id":[0,136,247],"loc":[64,149,237],"line":{"line":"Hmm hmm.","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\DialogueGe_DialogueGeneric_000854CE_1.wav"},"topic":[65,64,254]},{"time":20101231611,"id":[0,150,82],"loc":[65,146,193],"line":{"line":"Gods... damn you!","wav":"Sound\\Voice\\Skyrim.esm\\MaleKhajiit\\DialogueGeneric__00096848_1.wav"},"topic":[65,62,227]},{"time":20101231612,"id":[0,150,82],"loc":[65,146,193],"line":{"line":"Nuh...","wav":"Sound\\Voice\\Skyrim.esm\\MaleKhajiit\\DialogueGeneric__00096502_1.wav"},"topic":[65,62,228]},{"time":20101231617,"id":[67,247,184],"loc":[65,146,193],"line":{"line":"Now you're mine!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleEvenToned\\DialogueGeneric__0006CB18_1.wav"},"topic":[65,193,199]},{"time":20101231618,"id":[67,247,184],"loc":[65,146,193],"line":{"line":"Die, damn you!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleEvenToned\\DialogueGeneric__00096838_1.wav"},"topic":[65,62,227]},{"time":20101231619,"id":[67,247,184],"loc":[65,146,193],"line":{"line":"Fool, I will see you dead!","wav":"Sound\\Voice\\Bandit Lines Expansion.esp\\FemaleEvenToned\\BanditLine_BLE_Taunt_000008A6_1.wav"},"topic":[1,236,159]},{"time":20101231619,"id":[0,150,56],"loc":[65,146,193],"line":{"line":"Fool! I'll have your blood!","wav":"Sound\\Voice\\Bandit Lines Expansion.esp\\MaleCommoner\\BanditLine_BLE_Taunt_000008FE_1.wav"},"topic":[1,236,159]},{"time":20101231621,"id":[67,247,184],"loc":[65,146,193],"line":{"line":"Time to die, hero!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleEvenToned\\DialogueCo_DCETAttack_000B876B_1.wav"},"topic":[75,135,106]},{"time":20101231624,"id":[67,247,184],"loc":[65,146,193],"line":{"line":"Grrargh!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleEvenToned\\DialogueGeneric__00013EEF_1.wav"},"topic":[65,62,227]},{"time":20101231625,"id":[67,247,184],"loc":[65,146,193],"line":{"line":"It's... nothing...","wav":"Sound\\Voice\\Skyrim.esm\\FemaleEvenToned\\DialogueGeneric__00096500_1.wav"},"topic":[65,62,187]},{"time":20101231626,"id":[67,247,184],"loc":[65,146,193],"line":{"line":"Nargh!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleEvenToned\\DialogueGeneric__00042ED3_1.wav"},"topic":[65,62,187]},{"time":20101231626,"id":[67,247,184],"loc":[65,146,193],"line":{"line":"Nuh...","wav":"Sound\\Voice\\Skyrim.esm\\FemaleEvenToned\\DialogueGeneric__00096502_1.wav"},"topic":[65,62,228]},{"time":20101231626,"id":[0,150,56],"loc":[65,146,193],"line":{"line":"Damn you...","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\DialogueGeneric__000494AB_1.wav"},"topic":[68,102,72]},{"time":20101231630,"id":[0,150,56],"loc":[65,146,193],"line":{"line":"You won't get the best of me!","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\DialogueGeneric__000494A5_1.wav"},"topic":[68,102,72]},{"time":20101231630,"id":[0,150,56],"loc":[65,146,193],"line":{"line":"Weergh!","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\DialogueGeneric__00042ED5_1.wav"},"topic":[65,62,187]},{"time":20101231630,"id":[0,150,56],"loc":[65,146,193],"line":{"line":"Yeagh!","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\DialogueGeneric__00013EF7_1.wav"},"topic":[65,62,187]},{"time":20101231631,"id":[0,150,56],"loc":[65,146,193],"line":{"line":"Agghh! ","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\DialogueGeneric__00017702_1.wav"},"topic":[65,63,48]},{"time":20101231648,"id":[67,247,179],"loc":[65,146,193],"line":{"line":"Are you truly ready to die? I'll try and make this quick!","wav":"Sound\\Voice\\Bandit Lines Expansion.esp\\FemaleNord\\BanditLine_BLE_Taunt_000009B6_1.wav"},"topic":[1,236,159]},{"time":20101231649,"id":[67,247,177],"loc":[65,146,193],"line":{"line":"I will claw the eyes out of you, fool!","wav":"Sound\\Voice\\Bandit Lines Expansion.esp\\MaleKhajiit\\BanditLine_BLE_Taunt_0000083A_1.wav"},"topic":[1,236,159]},{"time":20101231715,"id":[67,247,172],"loc":[65,146,193],"line":{"line":"I knew I'd find you!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleNord\\DialogueGeneric__0001C1DD_1.wav"},"topic":[65,193,193]},{"time":20101231716,"id":[67,247,173],"loc":[65,146,193],"line":{"line":"You ready to die today? Huh?","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\DialogueGeneric__000494AA_1.wav"},"topic":[68,102,72]},{"time":20101231716,"id":[67,247,173],"loc":[65,146,193],"line":{"line":"Nyyarrggh!","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\DialogueGeneric__00013EF1_1.wav"},"topic":[65,62,227]},{"time":20101231717,"id":[67,247,172],"loc":[65,146,193],"line":{"line":"Yearrgh!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleNord\\DialogueGeneric__000B8A05_1.wav"},"topic":[65,62,227]},{"time":20101231718,"id":[67,247,172],"loc":[65,146,193],"line":{"line":"Weergh!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleNord\\DialogueGeneric__00042ED5_1.wav"},"topic":[65,62,187]},{"time":20101231718,"id":[67,247,172],"loc":[65,146,193],"line":{"line":"Argh!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleNord\\DialogueGeneric__00042ED4_1.wav"},"topic":[65,62,187]},{"time":20101231720,"id":[67,247,172],"loc":[65,145,94],"line":{"line":"Ha! I think you're bleeding!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleNord\\DialogueGeneric__00096880_1.wav"},"topic":[65,62,227]},{"time":20101231721,"id":[67,247,173],"loc":[65,145,94],"line":{"line":"Grrargh!","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\DialogueGeneric__00013EEF_1.wav"},"topic":[65,62,227]},{"time":20101231721,"id":[67,247,172],"loc":[65,145,94],"line":{"line":"Weergh!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleNord\\DialogueGeneric__00042ED5_1.wav"},"topic":[65,62,187]},{"time":20101231722,"id":[128,19,85],"loc":[65,145,94],"line":{"line":"Nuh...","wav":"Sound\\Voice\\Skyrim.esm\\FemaleEvenToned\\DialogueGeneric__00096502_1.wav"},"topic":[65,62,228]},{"time":20101231723,"id":[67,247,172],"loc":[65,145,94],"line":{"line":"Over here!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleNord\\DialogueGe_DialogueGeneric_0006CE5C_1.wav"},"topic":[65,193,199]},{"time":20101231725,"id":[67,247,172],"loc":[64,149,237],"line":{"line":"Think you can take me?","wav":"Sound\\Voice\\Skyrim.esm\\FemaleNord\\DialogueGeneric__000494E3_1.wav"},"topic":[68,102,72]},{"time":20101240204,"id":[73,7,62],"loc":[65,146,123],"line":{"line":"Hey, who's there?","wav":"Sound\\Voice\\Skyrim.esm\\MaleCoward\\dunMistwatchQST__000C00F0_1.wav"},"topic":[76,0,239]},{"time":20101240206,"id":[73,7,62],"loc":[65,146,123],"line":{"line":"You - over here, quick. Before any of them show up!","wav":"Sound\\Voice\\Skyrim.esm\\MaleCoward\\dunMistwatchQST__000936CD_1.wav"},"topic":[73,54,204]},{"time":20101240208,"id":[73,7,62],"loc":[65,146,123],"line":{"line":"Please, stranger! I need your help!","wav":"Sound\\Voice\\Skyrim.esm\\MaleCoward\\dunMistwatchQST__000936CE_1.wav"},"topic":[73,54,203]},{"time":20101240217,"id":[68,90,185],"loc":[65,146,123],"line":{"line":"Never should have come here...","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\DialogueGeneric__000854C2_1.wav"},"topic":[65,193,198]},{"time":20101240218,"id":[68,91,81],"loc":[65,146,123],"line":{"line":"Come on!","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\DialogueGeneric__0001C1D7_1.wav"},"topic":[65,193,198]},{"time":20101240219,"id":[68,90,185],"loc":[65,146,123],"line":{"line":"Hyargh!","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\DialogueGeneric__000176FD_1.wav"},"topic":[65,62,227]},{"time":20101240219,"id":[68,90,185],"loc":[65,146,123],"line":{"line":"Weergh!","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\DialogueGeneric__00042ED5_1.wav"},"topic":[65,62,187]},{"time":20101240220,"id":[68,90,185],"loc":[65,146,123],"line":{"line":"Nargh!","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\DialogueGeneric__00042ED3_1.wav"},"topic":[65,62,187]},{"time":20101240220,"id":[68,91,81],"loc":[65,146,123],"line":{"line":"Aggghh!","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\DialogueGeneric__00013EF0_1.wav"},"topic":[65,62,227]},{"time":20101240220,"id":[68,90,185],"loc":[65,146,123],"line":{"line":"Nuh...","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\DialogueGeneric__00096502_1.wav"},"topic":[65,62,228]},{"time":20101240221,"id":[68,91,81],"loc":[65,146,123],"line":{"line":"Weergh!","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\DialogueGeneric__00042ED5_1.wav"},"topic":[65,62,187]},{"time":20101240222,"id":[68,91,81],"loc":[65,146,123],"line":{"line":"Prepare to die!","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\DialogueGeneric__000494AE_1.wav"},"topic":[68,102,72]},{"time":20101240223,"id":[68,91,81],"loc":[65,146,123],"line":{"line":"Nuh...","wav":"Sound\\Voice\\Skyrim.esm\\MaleCommoner\\DialogueGeneric__00096502_1.wav"},"topic":[65,62,228]},{"time":20101240708,"id":[0,150,80],"loc":[65,146,193],"line":{"line":"What was that?","wav":"Sound\\Voice\\Skyrim.esm\\MaleBandit\\DialogueGe_DialogueGeneric_0006CB28_1.wav"},"topic":[65,193,200]},{"time":20101240721,"id":[0,136,241],"loc":[64,149,242],"line":{"line":"Until next time.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleDarkElf\\DialogueGe_DialogueGeneric_00087935_1.wav"},"topic":[65,64,254]},{"time":20101240723,"id":[0,136,241],"loc":[64,149,242],"line":{"line":"All right, then.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleDarkElf\\DialogueGe_DialogueGeneric_000854CD_1.wav"},"topic":[65,64,254]},{"time":20101240743,"id":[77,150,81],"loc":[77,86,122],"line":{"line":"I'm warning you. Back off!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleElfHaughty\\DialogueGeneric__000BABE1_1.wav"},"topic":[66,164,87]},{"time":20101240747,"id":[0,149,245],"loc":[65,145,139],"line":{"line":"I'm getting out of here!","wav":"Sound\\Voice\\Skyrim.esm\\MaleElfHaughty\\DialogueGeneric__000A9B4F_1.wav"},"topic":[67,64,54]},{"time":20101240748,"id":[77,150,81],"loc":[77,86,122],"line":{"line":"That's close enough.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleElfHaughty\\DialogueGeneric__000BABE0_1.wav"},"topic":[66,164,87]},{"time":20101240749,"id":[77,150,81],"loc":[77,86,122],"line":{"line":"Never should have come here...","wav":"Sound\\Voice\\Skyrim.esm\\FemaleElfHaughty\\DialogueGeneric__000854C2_1.wav"},"topic":[65,193,198]},{"time":20101240750,"id":[77,150,81],"loc":[77,86,122],"line":{"line":"Argh!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleElfHaughty\\DialogueGeneric__00042ED4_1.wav"},"topic":[65,62,187]},{"time":20101240750,"id":[77,150,81],"loc":[77,86,122],"line":{"line":"Yeagh!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleElfHaughty\\DialogueGeneric__00013EF7_1.wav"},"topic":[65,62,187]},{"time":20101240751,"id":[77,150,81],"loc":[77,86,122],"line":{"line":"Hunh...","wav":"Sound\\Voice\\Skyrim.esm\\FemaleElfHaughty\\DialogueGeneric__0002E359_1.wav"},"topic":[65,62,228]},{"time":20101241050,"id":[128,36,164],"loc":[64,150,21],"line":{"line":"Yearrgh!","wav":"Sound\\Voice\\Skyrim.esm\\MaleBrute\\DialogueGeneric__000B8A05_1.wav"},"topic":[65,62,227]},{"time":20101241053,"id":[128,36,164],"loc":[64,150,22],"line":{"line":"Yearrgh!","wav":"Sound\\Voice\\Skyrim.esm\\MaleBrute\\DialogueGeneric__000B8A05_1.wav"},"topic":[65,62,227]},{"time":20101241053,"id":[128,36,164],"loc":[64,150,21],"line":{"line":"I'm gonna kill you!","wav":"Sound\\Voice\\Skyrim.esm\\MaleBrute\\DialogueGeneric__000494C8_1.wav"},"topic":[68,102,72]},{"time":20101241055,"id":[128,36,164],"loc":[64,150,22],"line":{"line":"That your best? Huh?","wav":"Sound\\Voice\\Skyrim.esm\\MaleBrute\\DialogueGeneric__000964FF_1.wav"},"topic":[65,62,187]},{"time":20101241056,"id":[128,36,164],"loc":[64,150,22],"line":{"line":"Hyargh!","wav":"Sound\\Voice\\Skyrim.esm\\MaleBrute\\DialogueGeneric__000176FD_1.wav"},"topic":[65,62,227]},{"time":20101241057,"id":[0,136,251],"loc":[64,150,22],"line":{"line":"I'm getting out of here!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleDarkElf\\DialogueGeneric__000A9B4F_1.wav"},"topic":[67,64,54]},{"time":20101241058,"id":[128,36,164],"loc":[64,150,22],"line":{"line":"Hunh...","wav":"Sound\\Voice\\Skyrim.esm\\MaleBrute\\DialogueGeneric__0002E359_1.wav"},"topic":[65,62,228]},{"time":20101241105,"id":[0,136,251],"loc":[64,150,21],"line":{"line":"Another corpse for the pile.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleDarkElf\\DialogueGeneric__000A9B68_1.wav"},"topic":[67,48,169]},{"time":20101241131,"id":[75,41,120],"loc":[65,138,86],"line":{"line":"Somebody help!","wav":"Sound\\Voice\\Skyrim.esm\\MaleYoungEager\\DialogueGeneric__000A7B02_1.wav"},"topic":[67,64,54]},{"time":20101241136,"id":[65,166,165],"loc":[65,138,86],"line":{"line":"If you run into my husband Nazeem, remind him that he's not married to himself.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleEvenToned\\DialogueWhiterun__000904FD_1.wav"},"topic":[73,4,172]},{"time":20101241145,"id":[75,41,120],"loc":[65,138,86],"line":{"line":"Mallus is teaching me everything he knows about brewing. Hopefully, I can take over his position some day.","wav":"Sound\\Voice\\Skyrim.esm\\MaleYoungEager\\TGPre_TGPreHellos_000B296D_1.wav"},"topic":[75,41,103]},{"time":20101241203,"id":[73,25,24],"loc":[65,138,86],"line":{"line":"By Ysmir, it's true. A jester - funny suit and all. Just north, by the Loreius Farm. Fool had a coffin in a cart, with a broken wheel.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCommander\\DialogueWhiterun__00092B1A_1.wav"},"topic":[73,43,17]},{"time":20101241208,"id":[73,25,24],"loc":[65,138,86],"line":{"line":"Like to see him laugh his way out of that.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCommander\\DialogueWhiterun__000BC8B5_1.wav"},"topic":[75,200,177]},{"time":20101241209,"id":[73,25,24],"loc":[65,138,86],"line":{"line":"Just fists. No weapons, no magic... no crying. Let's go!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCommander\\Favor017_Favor017QuestAcce_00055A0B_1.wav"},"topic":[76,161,231]},{"time":20101241210,"id":[73,25,24],"loc":[65,138,86],"line":{"line":"Ha ha ha ha ha ha ha!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCommander\\DialogueWhiterun__000BC8B4_1.wav"},"topic":[75,200,176]},{"time":20101241210,"id":[73,25,24],"loc":[65,138,86],"line":{"line":"Well, well. Another maggot to squash beneath my boot.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCommander\\DialogueGeneric__000854BF_1.wav"},"topic":[65,193,198]},{"time":20101241211,"id":[73,25,24],"loc":[65,138,86],"line":{"line":"Come on. Let's see what you're made of.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCommander\\DGIntimidateQuest__0002C59D_1.wav"},"topic":[66,197,156]},{"time":20101241211,"id":[65,166,156],"loc":[65,138,86],"line":{"line":"Ha ha ha ha ha ha ha!","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\DialogueWhiterun__00092B1F_1.wav"},"topic":[73,43,18]},{"time":20101241211,"id":[65,54,152],"loc":[65,138,86],"line":{"line":"Just keep swinging!","wav":"Sound\\Voice\\Brawl Lines Expansion.esp\\MaleCommonerAccented\\DGIntimida_DGIntimidateQue_00000D74_1.wav"},"topic":[2,7,215]},{"time":20101241211,"id":[73,25,24],"loc":[65,138,86],"line":{"line":"Yearrgh!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCommander\\DialogueGeneric__000B8A05_1.wav"},"topic":[65,62,227]},{"time":20101241212,"id":[65,166,156],"loc":[65,138,86],"line":{"line":"Who taught you to fight? Keep those hands up!","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\DGIntimidateQuest__000AA743_1.wav"},"topic":[66,197,154]},{"time":20101241213,"id":[73,25,24],"loc":[65,138,86],"line":{"line":"Hyargh!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCommander\\DialogueGeneric__000176FD_1.wav"},"topic":[65,62,227]},{"time":20101241215,"id":[65,166,156],"loc":[65,138,86],"line":{"line":"Come on! Keep your guard up and wait for an opening!","wav":"SOUND\\Voice\\Brawl Lines Expansion.esp\\malenord\\DGIntimidateQuest__00000813_1.wav"},"topic":[66,197,154]},{"time":20101241217,"id":[65,54,152],"loc":[65,138,86],"line":{"line":"Good fight going here.","wav":"Sound\\Voice\\Brawl Lines Expansion.esp\\MaleCommonerAccented\\DGIntimida_DGIntimidateQue_00000D73_1.wav"},"topic":[2,7,215]},{"time":20101241218,"id":[73,25,24],"loc":[65,138,86],"line":{"line":"Yeagh!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCommander\\DialogueGeneric__00013EF7_1.wav"},"topic":[65,62,187]},{"time":20101241218,"id":[65,166,156],"loc":[65,138,86],"line":{"line":"Twelve septims on the big one!","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\DGIntimidateQuest__0002C59F_1.wav"},"topic":[66,197,154]},{"time":20101241219,"id":[73,25,24],"loc":[65,138,86],"line":{"line":"Argh!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCommander\\DialogueGeneric__00042ED4_1.wav"},"topic":[65,62,187]},{"time":20101241219,"id":[73,25,24],"loc":[65,138,86],"line":{"line":"Agh!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCommander\\DialogueGeneric__0006F41E_1.wav"},"topic":[65,62,187]},{"time":20101241220,"id":[73,25,24],"loc":[65,138,86],"line":{"line":"Agh!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCommander\\DialogueGeneric__0006F41E_1.wav"},"topic":[65,62,187]},{"time":20101241220,"id":[73,25,24],"loc":[65,138,86],"line":{"line":"Nargh!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCommander\\DialogueGeneric__00042ED3_1.wav"},"topic":[65,62,187]},{"time":20101241221,"id":[73,25,24],"loc":[65,138,86],"line":{"line":"Yeagh!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCommander\\DialogueGeneric__00013EF7_1.wav"},"topic":[65,62,187]},{"time":20101241222,"id":[65,166,156],"loc":[65,138,86],"line":{"line":"Drive that snowback to the ground. Come on!","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\DGIntimidateQuest__0002C5A0_1.wav"},"topic":[66,197,154]},{"time":20101241222,"id":[73,25,24],"loc":[65,138,86],"line":{"line":"Come on! Let's see you put up a fight!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCommander\\DialogueGeneric__00049BAF_1.wav"},"topic":[68,102,72]},{"time":20101241223,"id":[73,25,24],"loc":[65,138,86],"line":{"line":"Nargh!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCommander\\DialogueGeneric__00042ED3_1.wav"},"topic":[65,62,187]},{"time":20101241223,"id":[73,25,24],"loc":[65,138,86],"line":{"line":"Nargh!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCommander\\DialogueGeneric__00042ED3_1.wav"},"topic":[65,62,187]},{"time":20101241224,"id":[73,25,24],"loc":[65,138,86],"line":{"line":"That the best you can do?","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCommander\\DialogueGeneric__00013EF5_1.wav"},"topic":[65,62,187]},{"time":20101241224,"id":[65,166,156],"loc":[65,138,86],"line":{"line":"Fight! Fight!","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\DGIntimidateQuest__0002C5A1_1.wav"},"topic":[66,197,154]},{"time":20101241225,"id":[73,25,24],"loc":[65,138,86],"line":{"line":"Oof!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCommander\\DialogueGeneric__00042ED2_1.wav"},"topic":[65,62,187]},{"time":20101241227,"id":[73,25,24],"loc":[65,138,86],"line":{"line":"I. Will. Destroy you!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCommander\\DialogueGeneric__00049BAE_1.wav"},"topic":[68,102,72]},{"time":20101241227,"id":[65,166,156],"loc":[65,138,86],"line":{"line":"Fight! Fight!","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\DGIntimidateQuest__0002C5A1_1.wav"},"topic":[66,197,154]},{"time":20101241227,"id":[73,25,24],"loc":[65,138,86],"line":{"line":"Rrarggh!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCommander\\DialogueGeneric__00013EF4_1.wav"},"topic":[65,62,227]},{"time":20101241229,"id":[65,166,156],"loc":[65,138,86],"line":{"line":"Come on! Come on!","wav":"Sound\\Voice\\Brawl Lines Expansion.esp\\MaleNord\\DGIntimidateQuest__00000800_1.wav"},"topic":[66,197,154]},{"time":20101241229,"id":[73,25,24],"loc":[65,138,86],"line":{"line":"Agh!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCommander\\DialogueGeneric__0006F41E_1.wav"},"topic":[65,62,187]},{"time":20101241230,"id":[73,25,24],"loc":[65,138,86],"line":{"line":"Weergh!","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCommander\\DialogueGeneric__00042ED5_1.wav"},"topic":[65,62,187]},{"time":20101241231,"id":[73,25,24],"loc":[65,138,86],"line":{"line":"You think I'm afraid of you?","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCommander\\DialogueGeneric__00049BB1_1.wav"},"topic":[68,102,72]},{"time":20101241238,"id":[73,25,24],"loc":[65,138,86],"line":{"line":"You're no liar. Best fight I've had in years. There you are.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCommander\\DGIntimida_DGIntimidateVic_000C0B77_1.wav"},"topic":[68,122,197]},{"time":20101241256,"id":[65,166,137],"loc":[65,138,86],"line":{"line":"We'll pay whatever it takes, but we must have more swords for the Imperial soldiers.","wav":"Sound\\Voice\\Skyrim.esm\\MaleBrute\\DialogueWhiterun__000CC7AE_1.wav"},"topic":[76,199,171]},{"time":20101241258,"id":[65,166,124],"loc":[65,138,86],"line":{"line":"I just can't fill an order that size on my own. ","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCommander\\DialogueWhiterun__000CC7AF_1.wav"},"topic":[76,199,170]},{"time":20101241300,"id":[65,166,137],"loc":[65,138,86],"line":{"line":"Ha! I'd sooner bend my knee to Ulfric Stormcloak.","wav":"Sound\\Voice\\Skyrim.esm\\MaleBrute\\DialogueWhiterun__000CC7AD_1.wav"},"topic":[76,199,169]},{"time":20101241302,"id":[65,166,124],"loc":[65,138,86],"line":{"line":"Have it your way. I'll take the job, but don't expect a miracle.","wav":"Sound\\Voice\\Skyrim.esm\\FemaleCommander\\DialogueWhiterun__000CC7AC_1.wav"},"topic":[76,199,168]},{"time":20101241551,"id":[65,52,130],"loc":[65,49,99],"line":{"line":"Good day.","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\DialogueGe_DialogueGeneric_00014105_1.wav"},"topic":[65,64,254]},{"time":20101241551,"id":[65,52,130],"loc":[65,49,99],"line":{"line":"That's a decent weapon you've made there.","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\WICraftItem01__0009C135_1.wav"},"topic":[68,244,253]},{"time":20101241557,"id":[65,52,130],"loc":[65,49,99],"line":{"line":"All right, then.","wav":"Sound\\Voice\\Skyrim.esm\\MaleNord\\DialogueGe_DialogueGeneric_000854CD_1.wav"},"topic":[65,64,254]},{"time":20101241558,"id":[0,43,164],"loc":[65,49,99],"line":{"line":"The name's Hjoromir, and I'm just the man for the job.","wav":"Sound\\Voice\\3DNPC.esp\\HjoromirVoice\\DialogueFo_DialogueFollowe_000AE842_1.wav"},"topic":[2,9,34]},{"time":20101241600,"id":[0,43,164],"loc":[65,49,99],"line":{"line":"Yes?","wav":"Sound\\Voice\\3DNPC.esp\\HjoromirVoice\\DialogueFo_DialogueFollowe_000AE84E_1.wav"},"topic":[2,9,34]},{"time":20101241603,"id":[0,43,164],"loc":[65,49,99],"line":{"line":"You sure look like you could use some help.","wav":"Sound\\Voice\\3DNPC.esp\\HjoromirVoice\\DialogueHj_DialogueHjoromi_0005628F_1.wav"},"topic":[2,9,35]},{"time":20101241606,"id":[0,43,164],"loc":[65,49,99],"line":{"line":"You sure look like you could use some help.","wav":"Sound\\Voice\\3DNPC.esp\\HjoromirVoice\\DialogueFo_DialogueFollowe_000AE843_1.wav"},"topic":[2,9,34]},{"time":20101241610,"id":[0,43,164],"loc":[65,49,99],"line":{"line":"You sure look like you could use some help.","wav":"Sound\\Voice\\3DNPC.esp\\HjoromirVoice\\DialogueFo_DialogueFollowe_000AE843_1.wav"},"topic":[2,9,34]}]